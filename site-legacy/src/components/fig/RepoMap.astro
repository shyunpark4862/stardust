---
/**
 * The repository at a glance: the top-level entries as a short list, then
 * the C++ folders as cards in groups. Each area's card carries the area's
 * colour; file names are plain text that wraps.
 *
 *   top     [{ name, note }]                       entries at the top level
 *   groups  [{ title, note?, cards: [{ name, area?, files?, subs? }] }]
 *             area   key of the area colour ('array', 'stats', ...)
 *             files  file names in the folder
 *             subs   sub-folders: [{ name, files?, note? }]
 */
interface Sub {
  name: string;
  files?: string[];
  note?: string;
}
interface Card {
  name: string;
  area?: string;
  files?: string[];
  subs?: Sub[];
}
interface Group {
  title: string;
  note?: string;
  cards: Card[];
}
interface Props {
  top: { name: string; note: string }[];
  groups: Group[];
}
const { top, groups } = Astro.props;
---

<div class="repo">
  <dl class="repo__top">
    {
      top.map((t) => (
        <div class="repo__entry">
          <dt>
            <code>{t.name}</code>
          </dt>
          <dd>{t.note}</dd>
        </div>
      ))
    }
  </dl>

  {
    groups.map((g) => (
      <section class="repo__group">
        <header class="repo__head">
          <span class="repo__title">{g.title}</span>
          {g.note && <span class="repo__note">{g.note}</span>}
        </header>
        <div class="repo__cards">
          {g.cards.map((c) => (
            <div class:list={['repo__card', c.area && 'repo__card--area']} data-area={c.area}>
              <code class="repo__name">{c.name}</code>
              {c.files && (
                <p class="repo__files">
                  {c.files.map((f) => (
                    <span>{f}</span>
                  ))}
                </p>
              )}
              {c.subs?.map((s) => (
                <div class="repo__sub">
                  <code class="repo__subname">{s.name}</code>
                  {s.files && (
                    <p class="repo__files">
                      {s.files.map((f) => (
                        <span>{f}</span>
                      ))}
                    </p>
                  )}
                  {s.note && <p class="repo__subnote">{s.note}</p>}
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>
    ))
  }
</div>

<style>
  .repo {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    width: 100%;
  }

  /* Top level: name and what it is, two columns. */
  .repo__top {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-2) var(--space-5);
    margin: 0;
  }
  .repo__entry {
    display: contents;
  }
  .repo__top dt,
  .repo__top dd {
    margin: 0;
  }
  .repo__top code {
    padding: 0;
    border: 0;
    background: none;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--fg);
  }
  .repo__top dd {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-muted);
  }

  .repo__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin-bottom: var(--space-3);
  }
  .repo__title {
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--fg);
  }
  .repo__note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-subtle);
  }
  /* Two flowing columns: a short card does not stretch to its neighbour. */
  .repo__cards {
    columns: 2;
    column-gap: var(--space-3);
  }

  .repo__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    padding: var(--space-3) var(--space-4);
    break-inside: avoid;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg);
  }
  .repo__card--area {
    border-left: 3px solid var(--area);
  }
  .repo__name {
    padding: 0;
    border: 0;
    background: none;
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--fg);
  }
  .repo__card--area .repo__name {
    color: var(--area);
  }

  /* File names: plain text in the code font, spaced apart, wrapping. */
  .repo__files {
    display: flex;
    flex-wrap: wrap;
    gap: 2px var(--space-3);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.7;
    color: var(--slate-600);
  }

  .repo__sub {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: var(--space-2);
    border-top: 1px dashed var(--line);
  }
  .repo__subname {
    padding: 0;
    border: 0;
    background: none;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--fg-subtle);
  }
  .repo__subnote {
    margin: 0;
    font-size: var(--text-xs);
    line-height: 1.7;
    color: var(--fg-muted);
  }

  @media (max-width: 640px) {
    .repo__cards {
      columns: 1;
    }
    .repo__top {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .repo__top dd {
      margin-bottom: var(--space-2);
    }
  }
</style>

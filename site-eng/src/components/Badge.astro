---
interface Props {
  tone?: 'neutral' | 'accent' | 'ok' | 'warn';
}
const { tone = 'neutral' } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding-inline: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--bg-subtle);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .badge--accent {
    border-color: var(--accent-soft-line);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .badge--ok {
    border-color: color-mix(in srgb, var(--ok) 22%, transparent);
    background: var(--ok-soft);
    color: var(--ok);
  }
  .badge--warn {
    border-color: color-mix(in srgb, var(--warn) 22%, transparent);
    background: var(--warn-soft);
    color: var(--warn);
  }
</style>

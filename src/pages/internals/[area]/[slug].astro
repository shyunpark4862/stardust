---
import { getCollection, render } from 'astro:content';
import Docs from '../../../layouts/Docs.astro';
import { inlineHtml } from '../../../data/inline';
import {
  internalsAreaNav,
  internalsCrumbs,
  internalsGroups,
  internalsHref,
  internalsSidebar,
  splitInternalsId,
} from '../../../data/internals';

export async function getStaticPaths() {
  const entries = await getCollection('internals');
  return entries.map((entry) => {
    const [area, slug] = splitInternalsId(entry);
    return { params: { area, slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { area } = Astro.params;
const { data } = entry;
const { Content, headings: bodyHeadings } = await render(entry);

const ordered = (await internalsGroups(area)).flatMap((g) => g.entries);
const at = ordered.findIndex((e) => e.id === entry.id);
const prev = ordered[at - 1];
const next = ordered[at + 1];
const related = data.seeAlso
  .map((slug) => ordered.find((e) => splitInternalsId(e)[1] === slug))
  .filter((e) => e !== undefined);
const headings = [
  ...bodyHeadings.filter((h) => h.depth <= 3),
  ...(related.length > 0 ? [{ depth: 2, slug: '함께-보기', text: '함께 보기' }] : []),
];
---

<Docs
  title={data.title}
  description={data.summary}
  section="internals"
  crumbs={internalsCrumbs(area, data.group)}
  groups={await internalsSidebar(area)}
  area={await internalsAreaNav(area)}
  headings={headings}
>
  <Content />

  {
    related.length > 0 && (
      <>
        <h2 id="함께-보기">함께 보기</h2>
        <ul class="related">
          {related.map((e) => (
            <li>
              <a class="related__link" href={internalsHref(e)}>
                <span class="related__name">{e.data.title}</span>
                <span class="related__summary" set:html={inlineHtml(e.data.summary)} />
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <nav class="pager" aria-label="이전·다음 글">
    {
      prev ? (
        <a class="pager__link" href={internalsHref(prev)}>
          <span class="pager__dir">이전</span>
          <span class="pager__name">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="pager__link pager__link--next" href={internalsHref(next)}>
          <span class="pager__dir">다음</span>
          <span class="pager__name">{next.data.title}</span>
        </a>
      )
    }
  </nav>
</Docs>

<style>
  .related {
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .related li {
    margin: 0;
  }
  .related__link {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }
  .related__name {
    font-weight: 600;
    color: var(--accent);
  }
  .related__summary {
    color: var(--fg-muted);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-16);
  }
  .pager__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .pager__link:hover {
    border-color: var(--accent-soft-line);
    background: var(--accent-soft);
  }
  .pager__link--next {
    align-items: flex-end;
    text-align: right;
  }
  .pager__dir {
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--fg-subtle);
  }
  .pager__name {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--fg);
  }
  @media (max-width: 640px) {
    .related__link {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
  }
</style>

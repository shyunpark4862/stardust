---
import Docs from '../../layouts/Docs.astro';
import LinkCard from '../../components/LinkCard.astro';
import { internalsAreas } from '../../data/nav';
import { internalsAreasWithPages } from '../../data/internals';

const written = await internalsAreasWithPages();
---

<Docs
  title="구현"
  description="stardust가 안에서 어떻게 만들어졌는지 풀어 쓴 글이에요. 알고리즘, 자료 구조, 최적화와 그 이유, 성능과 정확도를 다뤄요."
  section="internals"
>
  <div class="grid">
    {
      internalsAreas.map((a) => (
        <LinkCard
          href={written.includes(a.key) ? `/internals/${a.key}/` : undefined}
          title={a.name}
          meta={a.ns}
          badge={written.includes(a.key) ? undefined : '준비 중'}
        >
          {a.desc || '준비 중이에요.'}
        </LinkCard>
      ))
    }
  </div>
</Docs>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
import Docs from '../../layouts/Docs.astro';
import LinkCard from '../../components/LinkCard.astro';
---

<Docs
  title="구현 개요"
  description="stardust가 안에서 어떻게 움직이는지 주제별로 풀어 쓰는 곳의 들머리예요."
  section="internals"
  sample
>
  <div class="grid">
    <LinkCard href="/internals/thread-pool/" title="스레드풀" meta="parallel" badge="샘플" badgeTone="accent">
      구현 상세 글 한 편이 어떻게 보이는지 확인하는 견본이에요.
    </LinkCard>
    <LinkCard title="다음 주제" meta="—" badge="준비 중">주제가 늘어나면 카드가 여기에 쌓여요.</LinkCard>
  </div>
</Docs>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

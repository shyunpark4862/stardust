---
import Docs from '../../../layouts/Docs.astro';
import Badge from '../../../components/Badge.astro';
import { areaCrumbs, areaNav, areaOf, areaSidebar, documentedAreas, groupId, groupsOf, hrefOf, isSingle } from '../../../data/api';

export async function getStaticPaths() {
  return (await documentedAreas()).map((area) => ({ params: { area } }));
}

const { area } = Astro.params;
const info = areaOf(area);
const groups = await groupsOf(area);
const headings = groups.map((g) => ({ depth: 2, slug: groupId(g.title), text: g.title }));
---

<Docs
  title={info.name}
  description={`${info.ns}의 문서 목록이에요. 이름을 누르면 그 페이지로 가요.`}
  section="api"
  crumbs={areaCrumbs(area).slice(0, 1)}
  groups={await areaSidebar(area)}
  area={await areaNav(area)}
  headings={headings}
>
  {
    groups.map((g) => (
      <>
        <h2 id={groupId(g.title)}>{g.title}</h2>
        <ul class="fn-list">
          {g.entries.map((e) => (
            <li>
              <a class="fn" href={hrefOf(e)}>
                <span class:list={['fn__name', !isSingle(e) && 'fn__name--text']}>{e.data.title}</span>
                <span class="fn__summary">
                  {e.data.summary}
                  {!isSingle(e) && e.data.names.length > 0 && (
                    <span class="fn__names">{e.data.names.join('  ')}</span>
                  )}
                </span>
                {e.data.tag && <Badge tone="accent">{e.data.tag}</Badge>}
              </a>
            </li>
          ))}
        </ul>
      </>
    ))
  }
</Docs>

<style>
  .fn-list {
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .fn-list li {
    margin: 0;
  }
  .fn {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    align-items: baseline;
    gap: var(--space-4);
    min-height: 52px;
    margin-inline: calc(var(--space-3) * -1);
    padding: var(--space-3);
    border-bottom: 1px solid var(--line);
    transition: background-color var(--dur-fast) var(--ease);
  }
  .fn:hover {
    background: var(--bg-subtle);
  }
  .fn__name {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--accent);
  }
  .fn__name--text {
    font-family: var(--font-sans);
  }
  .fn__names {
    display: block;
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    white-space: pre-wrap;
  }
  .fn__summary {
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
  }
  @media (max-width: 640px) {
    .fn {
      grid-template-columns: 1fr auto;
      gap: var(--space-1) var(--space-3);
    }
    .fn__name--text {
    font-family: var(--font-sans);
  }
  .fn__names {
    display: block;
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-subtle);
    white-space: pre-wrap;
  }
  .fn__summary {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>

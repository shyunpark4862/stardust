---
import { getCollection, render } from 'astro:content';
import Docs from '../../../layouts/Docs.astro';
import Badge from '../../../components/Badge.astro';
import ApiFields from '../../../components/ApiFields.astro';
import { areaOf, areaSidebar, groupsOf, hrefOf, isSingle, splitId } from '../../../data/api';

export async function getStaticPaths() {
  const entries = await getCollection('api');
  return entries.map((entry) => {
    const [area, fn] = splitId(entry);
    return { params: { area, fn }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { area } = Astro.params;
const { data } = entry;
const info = areaOf(area);
const { Content, headings: bodyHeadings } = await render(entry);

// Neighbours inside the area, in sidebar order.
const ordered = (await groupsOf(area)).flatMap((g) => g.entries);
const at = ordered.findIndex((e) => e.id === entry.id);
const prev = ordered[at - 1];
const next = ordered[at + 1];
const related = data.seeAlso
  .map((slug) => ordered.find((e) => splitId(e)[1] === slug))
  .filter((e) => e !== undefined);

const fixed = [
  data.params.length > 0 && '인자',
  data.returns && '반환',
  data.raises.length > 0 && '에러',
].filter((t): t is string => Boolean(t));
const headings = [
  ...fixed.map((text) => ({ depth: 2, slug: text, text })),
  ...bodyHeadings,
  ...(related.length > 0 ? [{ depth: 2, slug: '함께-보기', text: '함께 보기' }] : []),
];
---

<Docs
  title={data.title}
  description={data.summary}
  section="api"
  eyebrow={info.ns}
  monoTitle={isSingle(entry)}
  groups={await areaSidebar(area)}
  headings={headings}
  sample={data.sample}
>
  {
    data.signatures.length > 0 && (
      <div class="sig">
        <pre class="sig__code"><code>{data.signatures.join('\n')}</code></pre>
        {data.tag && <Badge tone="accent">{data.tag}</Badge>}
      </div>
    )
  }

  {
    data.params.length > 0 && (
      <>
        <h2 class="ref-h" id="인자">인자</h2>
        <ApiFields items={data.params} />
      </>
    )
  }
  {
    data.returns && (
      <>
        <h2 class="ref-h" id="반환">반환</h2>
        <ApiFields items={[data.returns]} />
      </>
    )
  }
  {
    data.raises.length > 0 && (
      <>
        <h2 class="ref-h" id="에러">에러</h2>
        <ApiFields items={data.raises} />
      </>
    )
  }

  <Content />

  {
    related.length > 0 && (
      <>
        <h2 id="함께-보기">함께 보기</h2>
        <ul class="related">
          {related.map((e) => (
            <li>
              <a class="related__link" href={hrefOf(e)}>
                <span class:list={['related__name', !isSingle(e) && 'related__name--text']}>{e.data.title}</span>
                <span class="related__summary">{e.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <nav class="pager" aria-label="이전·다음 함수">
    {
      prev ? (
        <a class="pager__link" href={hrefOf(prev)}>
          <span class="pager__dir">이전</span>
          <span class:list={['pager__name', !isSingle(prev) && 'pager__name--text']}>{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="pager__link pager__link--next" href={hrefOf(next)}>
          <span class="pager__dir">다음</span>
          <span class:list={['pager__name', !isSingle(next) && 'pager__name--text']}>{next.data.title}</span>
        </a>
      )
    }
  </nav>
</Docs>

<style>
  /* ---- Signature ---- */
  .sig {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-subtle);
  }
  .sig__code {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none !important;
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--blue-800);
    overflow-x: auto;
  }

  /* ---- Reference card headings ----
     Arguments, return value and errors read as one block, so their headings
     are a step smaller than the body's sections and carry no rule. */
  .ref-h {
    margin-top: var(--space-10);
    padding-top: 0;
    border-top: 0;
    font-size: var(--text-lg);
  }

  /* ---- See also ---- */
  .related {
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .related li {
    margin: 0;
  }
  .related__link {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }
  .related__name {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
  }
  .related__name--text,
  .pager__name--text {
    font-family: var(--font-sans);
  }
  .related__link:hover .related__name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .related__summary {
    color: var(--fg-muted);
  }

  /* ---- Previous / next ---- */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-16);
  }
  .pager__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .pager__link:hover {
    border-color: var(--accent-soft-line);
    background: var(--accent-soft);
  }
  .pager__link--next {
    align-items: flex-end;
    text-align: right;
  }
  .pager__dir {
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--fg-subtle);
  }
  .pager__name {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--fg);
  }
  @media (max-width: 640px) {
    .sig {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .sig__code {
      width: 100%;
    }
    .related__link {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>

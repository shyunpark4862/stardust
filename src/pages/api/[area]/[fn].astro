---
import { getCollection, render } from 'astro:content';
import Docs from '../../../layouts/Docs.astro';
import Badge from '../../../components/Badge.astro';
import { areaCrumbs, areaNav, areaSidebar, groupsOf, hrefOf, isSingle, splitId } from '../../../data/api';
import RefCard from '../../../components/RefCard.astro';
import Related from '../../../components/docs/Related.astro';
import Pager from '../../../components/docs/Pager.astro';

export async function getStaticPaths() {
  const entries = await getCollection('api');
  return entries.map((entry) => {
    const [area, fn] = splitId(entry);
    return { params: { area, fn }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { area } = Astro.params;
const { data } = entry;
const { Content, headings: bodyHeadings } = await render(entry);

// Neighbours inside the area, in sidebar order.
const ordered = (await groupsOf(area)).flatMap((g) => g.entries);
const at = ordered.findIndex((e) => e.id === entry.id);
const prev = ordered[at - 1];
const next = ordered[at + 1];
const related = data.seeAlso
  .map((slug) => ordered.find((e) => splitId(e)[1] === slug))
  .filter((e) => e !== undefined);
const link = (e: (typeof ordered)[number]) => ({ href: hrefOf(e), title: e.data.title, mono: isSingle(e) });

// The reference card (arguments, return value, errors) is placed by the page
// body with <Reference />, right after its first section; RefCard reads the
// data from here.
Astro.locals.apiEntry = data;
const hasCard = data.params.length > 0 || data.returns !== undefined || data.raises.length > 0;
const fixed = hasCard
  ? [
      { depth: 2, slug: 'reference', text: '인자와 반환값' },
      ...[
        data.params.length > 0 && '인자',
        data.returns && '반환',
        data.raises.length > 0 && '에러',
      ]
        .filter((t): t is string => Boolean(t))
        .map((text) => ({ depth: 3, slug: text, text })),
    ]
  : [];
const [first, ...rest] = bodyHeadings.filter((h) => h.depth <= 3);
const firstH2 = rest.findIndex((h) => h.depth === 2);
const headings = [
  ...(first ? [first] : []),
  ...(firstH2 === -1 ? rest : rest.slice(0, firstH2)),
  ...fixed,
  ...(firstH2 === -1 ? [] : rest.slice(firstH2)),
  ...(related.length > 0 ? [{ depth: 2, slug: '함께-보기', text: '함께 보기' }] : []),
];
---

<Docs
  title={data.title}
  description={data.summary}
  section="api"
  crumbs={areaCrumbs(area, data.group)}
  monoTitle={isSingle(entry)}
  groups={await areaSidebar(area)}
  area={await areaNav(area)}
  headings={headings}
  sample={data.sample}
>
  {
    data.signatures.length > 0 && (
      <div class="sig" slot="head">
        <pre class="sig__code"><code>{data.signatures.join('\n')}</code></pre>
        {data.tag && <Badge tone="accent">{data.tag}</Badge>}
      </div>
    )
  }

  <Content components={{ Reference: RefCard }} />

  <Related items={related.map((e) => ({ ...link(e), summary: e.data.summary }))} />
  <Pager label="이전·다음 함수" prev={prev && link(prev)} next={next && link(next)} />
</Docs>

<style>
  /* ---- Signature ---- */
  /* The signature belongs to the page head: it sits under the lead, above
     the rule that separates the head from the body. */
  .sig {
    display: flex;
    align-items: flex-start;
    margin-top: var(--space-6);
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-subtle);
  }
  .sig__code {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none !important;
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--blue-800);
    overflow-x: auto;
  }

  @media (max-width: 640px) {
    .sig {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .sig__code {
      width: 100%;
    }
  }
</style>

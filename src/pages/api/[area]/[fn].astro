---
import { getCollection, render } from 'astro:content';
import Docs from '../../../layouts/Docs.astro';
import { inlineHtml } from '../../../data/inline';
import Badge from '../../../components/Badge.astro';
import { areaCrumbs, areaNav, areaSidebar, groupsOf, hrefOf, isSingle, splitId } from '../../../data/api';
import RefCard from '../../../components/RefCard.astro';

export async function getStaticPaths() {
  const entries = await getCollection('api');
  return entries.map((entry) => {
    const [area, fn] = splitId(entry);
    return { params: { area, fn }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { area } = Astro.params;
const { data } = entry;
const { Content, headings: bodyHeadings } = await render(entry);

// Neighbours inside the area, in sidebar order.
const ordered = (await groupsOf(area)).flatMap((g) => g.entries);
const at = ordered.findIndex((e) => e.id === entry.id);
const prev = ordered[at - 1];
const next = ordered[at + 1];
const related = data.seeAlso
  .map((slug) => ordered.find((e) => splitId(e)[1] === slug))
  .filter((e) => e !== undefined);

// The reference card (arguments, return value, errors) is placed by the page
// body with <Reference />, right after its first section; RefCard reads the
// data from here.
Astro.locals.apiEntry = data;
const hasCard = data.params.length > 0 || data.returns !== undefined || data.raises.length > 0;
const fixed = hasCard
  ? [
      { depth: 2, slug: 'reference', text: '인자와 반환값' },
      ...[
        data.params.length > 0 && '인자',
        data.returns && '반환',
        data.raises.length > 0 && '에러',
      ]
        .filter((t): t is string => Boolean(t))
        .map((text) => ({ depth: 3, slug: text, text })),
    ]
  : [];
const [first, ...rest] = bodyHeadings.filter((h) => h.depth <= 3);
const firstH2 = rest.findIndex((h) => h.depth === 2);
const headings = [
  ...(first ? [first] : []),
  ...(firstH2 === -1 ? rest : rest.slice(0, firstH2)),
  ...fixed,
  ...(firstH2 === -1 ? [] : rest.slice(firstH2)),
  ...(related.length > 0 ? [{ depth: 2, slug: '함께-보기', text: '함께 보기' }] : []),
];
---

<Docs
  title={data.title}
  description={data.summary}
  section="api"
  crumbs={areaCrumbs(area, data.group)}
  monoTitle={isSingle(entry)}
  groups={await areaSidebar(area)}
  area={await areaNav(area)}
  headings={headings}
  sample={data.sample}
>
  {
    data.signatures.length > 0 && (
      <div class="sig" slot="head">
        <pre class="sig__code"><code>{data.signatures.join('\n')}</code></pre>
        {data.tag && <Badge tone="accent">{data.tag}</Badge>}
      </div>
    )
  }

  <Content components={{ Reference: RefCard }} />

  {
    related.length > 0 && (
      <>
        <h2 id="함께-보기">함께 보기</h2>
        <ul class="related">
          {related.map((e) => (
            <li>
              <a class="related__link" href={hrefOf(e)}>
                <span class:list={['related__name', !isSingle(e) && 'related__name--text']}>{e.data.title}</span>
                <span class="related__summary" set:html={inlineHtml(e.data.summary)} />
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <nav class="pager" aria-label="이전·다음 함수">
    {
      prev ? (
        <a class="pager__link" href={hrefOf(prev)}>
          <span class="pager__dir">이전</span>
          <span class:list={['pager__name', !isSingle(prev) && 'pager__name--text']}>{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="pager__link pager__link--next" href={hrefOf(next)}>
          <span class="pager__dir">다음</span>
          <span class:list={['pager__name', !isSingle(next) && 'pager__name--text']}>{next.data.title}</span>
        </a>
      )
    }
  </nav>
</Docs>

<style>
  /* ---- Signature ---- */
  /* The signature belongs to the page head: it sits under the lead, above
     the rule that separates the head from the body. */
  .sig {
    display: flex;
    align-items: flex-start;
    margin-top: var(--space-6);
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-subtle);
  }
  .sig__code {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none !important;
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--blue-800);
    overflow-x: auto;
  }

  /* ---- See also ---- */
  .related {
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .related li {
    margin: 0;
  }
  .related__link {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }
  .related__name {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
  }
  .related__name--text,
  .pager__name--text {
    font-family: var(--font-sans);
  }
  .related__link:hover .related__name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .related__summary {
    color: var(--fg-muted);
  }

  /* ---- Previous / next ---- */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-16);
  }
  .pager__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .pager__link:hover {
    border-color: var(--accent-soft-line);
    background: var(--accent-soft);
  }
  .pager__link--next {
    align-items: flex-end;
    text-align: right;
  }
  .pager__dir {
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--fg-subtle);
  }
  .pager__name {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--fg);
  }
  @media (max-width: 640px) {
    .sig {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .sig__code {
      width: 100%;
    }
    .related__link {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
  }
</style>

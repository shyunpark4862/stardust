---
import Docs from '../../layouts/Docs.astro';
import LinkCard from '../../components/LinkCard.astro';
import { areas } from '../../data/nav';
import { documentedAreas } from '../../data/api';

const documented = await documentedAreas();
---

<Docs
  title="API 개요"
  description="영역별 API 문서의 들머리예요. 영역을 고르면 그 영역의 함수 목록과 규칙으로 가요."
  section="api"
  sample
>
  <div class="grid">
    {
      areas.map((a) => (
        <LinkCard
          href={documented.includes(a.key) ? `/api/${a.key}/` : undefined}
          title={a.name}
          meta={a.ns}
          badge={documented.includes(a.key) ? (a.key === 'array' ? '작성 중' : '샘플') : '준비 중'}
          badgeTone={documented.includes(a.key) ? 'accent' : 'neutral'}
        >
          {a.desc}
        </LinkCard>
      ))
    }
  </div>
</Docs>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

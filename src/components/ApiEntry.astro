---
import Badge from './Badge.astro';

interface Param {
  name: string;
  type: string;
  desc: string;
  kind?: string;
}
interface Props {
  /** Function name without the namespace; also the anchor id. */
  name: string;
  /** Full call signature, shown in monospace. */
  signature: string;
  params?: Param[];
  returns?: { type: string; desc: string };
  raises?: { type: string; desc: string }[];
  tag?: string;
}
const { name, signature, params = [], returns, raises = [], tag } = Astro.props;
---

<section class="api" id={name}>
  <header class="api__head">
    <h3 class="api__name"><a class="api__anchor" href={`#${name}`}>{name}</a></h3>
    {tag && <Badge tone="accent">{tag}</Badge>}
  </header>
  <pre class="api__sig"><code>{signature}</code></pre>
  <div class="api__desc"><slot /></div>

  {
    params.length > 0 && (
      <dl class="api__list">
        <dt class="api__label">인자</dt>
        {params.map((p) => (
          <dd class="api__row">
            <span class="api__key">
              <code>{p.name}</code>
              {p.kind && <span class="api__kind">{p.kind}</span>}
            </span>
            <span class="api__type">{p.type}</span>
            <span class="api__text">{p.desc}</span>
          </dd>
        ))}
      </dl>
    )
  }
  {
    returns && (
      <dl class="api__list">
        <dt class="api__label">반환</dt>
        <dd class="api__row api__row--plain">
          <span class="api__type">{returns.type}</span>
          <span class="api__text">{returns.desc}</span>
        </dd>
      </dl>
    )
  }
  {
    raises.length > 0 && (
      <dl class="api__list">
        <dt class="api__label">에러</dt>
        {raises.map((r) => (
          <dd class="api__row api__row--plain">
            <span class="api__type">{r.type}</span>
            <span class="api__text">{r.desc}</span>
          </dd>
        ))}
      </dl>
    )
  }
</section>

<style>
  .api {
    margin-top: var(--space-10);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }
  .api__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .api__name {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .api__sig {
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-subtle);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--blue-800);
    overflow-x: auto;
  }
  .api__desc {
    margin-top: var(--space-4);
    font-size: var(--text-base);
  }
  .api__desc :global(> * + *) {
    margin-top: var(--space-3);
  }
  .api__list {
    margin: var(--space-5) 0 0;
  }
  .api__label {
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.02em;
    color: var(--fg-subtle);
  }
  .api__row {
    display: grid;
    grid-template-columns: 148px 132px 1fr;
    gap: var(--space-4);
    margin: 0;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }
  .api__row--plain {
    grid-template-columns: 148px 1fr;
  }
  .api__list:last-child .api__row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .api__key {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }
  .api__key code {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--fg);
  }
  .api__kind {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
  }
  .api__type {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--blue-700);
  }
  .api__text {
    color: var(--slate-700);
  }
  @media (max-width: 640px) {
    .api {
      padding: var(--space-5);
    }
    .api__row,
    .api__row--plain {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>

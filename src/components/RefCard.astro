---
/**
 * The reference card of a function page: arguments, return value and errors
 * in one framed block. Placed in the page body as <Reference /> (right after
 * "한눈에 보기"); the page route puts the entry's frontmatter in
 * Astro.locals.apiEntry.
 */
import ApiFields from './ApiFields.astro';

const data = Astro.locals.apiEntry;
---

{
  data && (
    <section class="ref" id="reference" aria-label="인자와 반환값">
      {data.params.length > 0 && (
        <>
          <h3 class="ref__h" id="인자">인자</h3>
          <ApiFields items={data.params} />
        </>
      )}
      {data.returns && (
        <>
          <h3 class="ref__h" id="반환">반환</h3>
          <ApiFields items={[data.returns]} />
        </>
      )}
      {data.raises.length > 0 && (
        <>
          <h3 class="ref__h" id="에러">에러</h3>
          <ApiFields items={data.raises} />
        </>
      )}
    </section>
  )
}

<style>
  /* A card, not three more sections: the labels are small and the frame
     sets the block apart from the running text. */
  .ref {
    margin-top: var(--space-10);
    padding: var(--space-2) var(--space-6) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
    scroll-margin-top: calc(var(--header-h) + var(--space-6));
  }
  .ref :global(.ref__h) {
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.04em;
    color: var(--fg-subtle);
  }
  .ref :global(.ref__h + *) {
    margin-top: var(--space-2);
  }
  .ref :global(.fields) {
    border-top-color: var(--line);
  }
  .ref :global(.fields__row:last-child) {
    border-bottom: 0;
  }
  @media (max-width: 640px) {
    .ref {
      padding-inline: var(--space-4);
    }
  }
</style>

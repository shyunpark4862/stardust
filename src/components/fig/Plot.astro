---
/**
 * A small function plot, drawn at build time.
 *
 *   curves  [{ f: (x) => y, label, dashed? }]   up to three
 *   domain  [x0, x1]        range  [y0, y1]
 *   xTicks / yTicks  [{ v, label }]  grid lines with labels
 */
interface Curve {
  f: (x: number) => number;
  label: string;
  dashed?: boolean;
}
interface Tick {
  v: number;
  label: string;
}
interface Props {
  curves: Curve[];
  domain: [number, number];
  range: [number, number];
  xTicks?: Tick[];
  yTicks?: Tick[];
}
const { curves, domain, range, xTicks = [], yTicks = [] } = Astro.props;

const W = 640;
const H = 260;
const pad = { l: 44, r: 16, t: 16, b: 30 };
const sx = (x: number) => pad.l + ((x - domain[0]) / (domain[1] - domain[0])) * (W - pad.l - pad.r);
const sy = (y: number) => H - pad.b - ((y - range[0]) / (range[1] - range[0])) * (H - pad.t - pad.b);

// Sample each curve; start a new stroke wherever the value leaves the frame
// (a pole of tan, the edge of acos's domain) so no line is drawn across the gap.
function pathOf(f: (x: number) => number): string {
  const n = 480;
  const slack = (range[1] - range[0]) * 0.02;
  let d = '';
  let pen = false;
  for (let i = 0; i <= n; i++) {
    const x = domain[0] + ((domain[1] - domain[0]) * i) / n;
    const y = f(x);
    const ok = Number.isFinite(y) && y >= range[0] - slack && y <= range[1] + slack;
    if (!ok) {
      pen = false;
      continue;
    }
    d += `${pen ? 'L' : 'M'}${sx(x).toFixed(1)} ${sy(y).toFixed(1)}`;
    pen = true;
  }
  return d;
}
const zeroX = domain[0] <= 0 && domain[1] >= 0;
const zeroY = range[0] <= 0 && range[1] >= 0;
---

<div class="plot">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={curves.map((c) => c.label).join(', ') + ' 그래프'}>
    {xTicks.map((t) => <line class="plot__grid" x1={sx(t.v)} x2={sx(t.v)} y1={pad.t} y2={H - pad.b} />)}
    {yTicks.map((t) => <line class="plot__grid" x1={pad.l} x2={W - pad.r} y1={sy(t.v)} y2={sy(t.v)} />)}
    {zeroY && <line class="plot__axis" x1={pad.l} x2={W - pad.r} y1={sy(0)} y2={sy(0)} />}
    {zeroX && <line class="plot__axis" x1={sx(0)} x2={sx(0)} y1={pad.t} y2={H - pad.b} />}
    {xTicks.map((t) => <text class="plot__tick" x={sx(t.v)} y={H - 10} text-anchor="middle">{t.label}</text>)}
    {yTicks.map((t) => <text class="plot__tick" x={pad.l - 8} y={sy(t.v) + 4} text-anchor="end">{t.label}</text>)}
    {curves.map((c, i) => <path class:list={['plot__curve', `plot__curve--${i}`, c.dashed && 'plot__curve--dashed']} d={pathOf(c.f)} />)}
  </svg>
  <ul class="plot__legend">
    {
      curves.map((c, i) => (
        <li>
          <span class:list={['plot__swatch', `plot__swatch--${i}`]} />
          {c.label}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .plot {
    width: 100%;
    max-width: 640px;
  }
  .plot svg {
    width: 100%;
    height: auto;
  }
  .plot__grid {
    stroke: var(--line);
    stroke-width: 1;
  }
  .plot__axis {
    stroke: var(--slate-400);
    stroke-width: 1;
  }
  .plot__tick {
    fill: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .plot__curve {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .plot__curve--0 {
    stroke: var(--blue-600);
  }
  .plot__curve--1 {
    stroke: var(--blue-300);
  }
  .plot__curve--2 {
    stroke: var(--slate-400);
  }
  .plot__curve--dashed {
    stroke-dasharray: 5 5;
  }
  .plot__legend {
    display: flex;
    justify-content: center;
    gap: var(--space-5);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }
  .plot__legend li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }
  .plot__swatch {
    width: 14px;
    height: 2px;
    border-radius: 1px;
  }
  .plot__swatch--0 {
    background: var(--blue-600);
  }
  .plot__swatch--1 {
    background: var(--blue-300);
  }
  .plot__swatch--2 {
    background: var(--slate-400);
  }
</style>

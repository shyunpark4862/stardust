---
/**
 * Accuracy measured against the reference values, from src/data/accuracy.json
 * (written by tools/sync_accuracy.py from the library's accuracy baselines).
 *
 * Without `area`: one row per measured area, in the library's order (sweeps,
 * points, (function, region) rows, how many of the rows with a numerical contract
 * are within it, the largest contract ratio), and under an area one indented row
 * per group of it (the stats area's multivariate group, sweeps mv/...).
 * With `area`: that area's rows, one per (function, region), with the columns of
 * the library's tables (bench/accuracy/tables.py) that some shown row has; the
 * count of NaN/inf points only when nonzero.
 *
 *   area     'array' | 'linalg' | 'special' | 'stats' | 'regression' | 'optimize' | 'htest' | 'sparse' | 'integrate' | 'differentiate'
 *   names    only these sweeps (array, linalg, special: function; stats:
 *            distribution_method, or mv/Class.method and mv/cdf.kind for the
 *            multivariate group; regression: kind/problem; optimize: method)
 *   regions  only these regions (guaranteed, loose, mixed, tiny, 'exact d<=3',
 *            'atol=...'; array: input kind and shape; linalg: kappa=...; optimize:
 *            problem set or stopping test; regression: field names)
 *   caption  text under the table
 */
import data from '../../data/accuracy.json';

type Cell = number | string | null;
interface Summary {
  sweeps: number;
  points: number;
  regions: number;
  judged: number;
  within: number;
  worst?: { contract: number; name: string; region: string };
}
interface AreaData {
  summary: Summary;
  groups?: Record<string, Summary>;
  regions: string[];
  sweeps: [string, number, Cell[][]][];
}
interface Props {
  area?: string;
  names?: string[];
  regions?: string[];
  caption?: string;
}
const { area, names, regions: onlyRegions, caption } = Astro.props;
const D = data as unknown as { fields: string[]; areas: Record<string, AreaData> };
const col = Object.fromEntries(D.fields.map((f, i) => [f, i]));

const AREA_NAMES: Record<string, string> = {
  array: 'sd 배열',
  linalg: 'sd.linalg',
  sparse: 'sd.sparse',
  special: 'sd.special',
  stats: 'sd.stats',
  regression: 'sd.regression',
  optimize: 'sd.optimize',
  htest: 'sd.htest',
  integrate: 'sd.integrate',
  differentiate: 'sd.differentiate',
};
const GROUP_NAMES: Record<string, string> = {
  'stats/mv': '다변량·행렬 분포 묶음',
};
const REGION_NAMES: Record<string, string> = {
  guaranteed: '보장',
  loose: '느슨',
  mixed: '혼합',
  tiny: '아주 작은 값',
  'exact d<=3': '정확 계산(d ≤ 3)',
};

/** Three significant digits; outside [1e-3, 1e5) as m × 10^e. */
function parts(v: Cell): { m: string; e?: number } {
  if (v === null || v === undefined) return { m: '' };
  if (typeof v === 'string') return { m: v };
  if (v === 0) return { m: '0' };
  const a = Math.abs(v);
  if (a >= 1e-3 && a < 1e5) return { m: String(Number(v.toPrecision(3))) };
  const [m, e] = v.toExponential(2).split('e');
  return { m: String(Number(m)), e: Number(e) };
}
const int = (n: number) => n.toLocaleString('en-US');

const one = area ? D.areas[area] : undefined;
if (area && !one) throw new Error(`AccuracySummary: no accuracy data for area ${area}`);

interface Row {
  name: string;
  region: string;
  cells: Cell[];
}
let rows: Row[] = [];
if (one) {
  for (const [name, , rs] of one.sweeps) {
    if (names && !names.includes(name)) continue;
    for (const r of rs) {
      const region = one.regions[r[0] as number];
      if (onlyRegions && !onlyRegions.includes(region)) continue;
      rows.push({ name, region, cells: r });
    }
  }
  if (names) rows.sort((a, b) => names.indexOf(a.name) - names.indexOf(b.name));
}
const get = (r: Row, f: string) => (r.cells.length > col[f] ? r.cells[col[f]] : null);
const has = (f: string) => rows.some((r) => get(r, f) !== null);
const regression = area === 'regression';
const columns: { key: string; head: string; show: boolean; pair?: string }[] = [
  { key: 'ulp_max', head: '최대 ULP', show: has('ulp_max') },
  { key: 'ulp_p999', head: '99.9% ULP', show: has('ulp_p999') },
  { key: 'ulp_scale_max', head: 'ULP / 배율', show: has('ulp_scale_max') },
  { key: 'mixed_max', head: 'mixed (최대 / 99.9%)', show: has('mixed_max'), pair: 'mixed_p999' },
  { key: 'rel_max', head: '최대 상대오차', show: has('rel_max') },
  { key: 'norm_rel', head: '노름 상대오차', show: has('norm_rel') },
  { key: 'norm_inf_rel_max', head: '노름 상대오차(∞)', show: has('norm_inf_rel_max') },
  { key: 'numpy_dist_max', head: 'numpy와의 ULP', show: has('numpy_dist_max') },
  { key: 'nonfinite', head: 'NaN·inf 점', show: rows.some((r) => Number(get(r, 'nonfinite') ?? 0) > 0) },
  { key: 'abs_max', head: '최대 절대오차', show: has('abs_max') },
  { key: 'rel_cond_max', head: '상대오차 / (u·조건수)', show: has('rel_cond_max') },
  { key: 'backward_max', head: '잔차 / (n·ε·척도)', show: has('backward_max') },
  { key: 'orth_max', head: '직교성 / (n·ε)', show: has('orth_max') },
  { key: 'grad_max', head: '최대 ‖∇f‖', show: has('grad_max') },
  { key: 'excess_max', head: '최대 (f − f*) / max(1, f*)', show: has('excess_max') },
  { key: 'tol_ratio_max', head: '거리 / 허용오차', show: has('tol_ratio_max') },
  { key: 'fnorm_max', head: '최대 ‖F‖∞', show: has('fnorm_max') },
  { key: 'kkt_max', head: 'KKT 잔차 / ε', show: has('kkt_max') },
  { key: 'unconverged', head: '수렴 못 함', show: has('unconverged') },
  { key: 'off_target', head: '판정 밖', show: has('off_target') },
  { key: 'est_ratio_max', head: '오차 / 추정', show: has('est_ratio_max') },
  { key: 'contract', head: '계약 대비', show: has('contract') },
].filter((c) => c.show);

/** The summary rows: each area, then its groups indented under it. */
const summaryRows: { label: string; group: boolean; s: Summary }[] = Object.entries(D.areas).flatMap(([key, a]) => [
  { label: AREA_NAMES[key] ?? key, group: false, s: a.summary },
  ...Object.entries(a.groups ?? {}).map(([g, s]) => ({
    label: GROUP_NAMES[`${key}/${g}`] ?? g,
    group: true,
    s,
  })),
]);
---

{
  !area && (
    <figure class="acc">
      <table>
        <thead>
          <tr>
            <th>영역</th>
            <th class="acc__num">스윕</th>
            <th class="acc__num">점</th>
            <th class="acc__num">(함수, 영역) 줄</th>
            <th class="acc__num">계약 안</th>
            <th>가장 큰 계약 대비</th>
          </tr>
        </thead>
        <tbody>
          {summaryRows.map(({ label, group, s }) => {
            const w = s.worst ? parts(s.worst.contract) : undefined;
            return (
              <tr class:list={[group && 'acc__group']}>
                <td>{group ? <span class="acc__sub">{label}</span> : <code>{label}</code>}</td>
                <td class="acc__num">{int(s.sweeps)}</td>
                <td class="acc__num">{int(s.points)}</td>
                <td class="acc__num">{int(s.regions)}</td>
                <td class="acc__num">{s.judged ? `${int(s.within)} / ${int(s.judged)}` : '계약 없음'}</td>
                <td>
                  {s.worst && w ? (
                    <>
                      <span class:list={['acc__ratio', s.worst.contract > 1 && 'is-over']}>{w.m}</span>{' '}
                      <code>{s.worst.name}</code>{' '}
                      {REGION_NAMES[s.worst.region] ?? <code>{s.worst.region}</code>}
                    </>
                  ) : (
                    '기준선과 비교만'
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      {caption && <figcaption class="acc__caption">{caption}</figcaption>}
    </figure>
  )
}
{
  area && (
    <figure class="acc">
      <table>
        <thead>
          <tr>
            <th>{regression ? '문제' : '함수'}</th>
            <th>{regression ? '필드' : '영역'}</th>
            <th class="acc__num">점</th>
            {columns.map((c) => (
              <th class="acc__num">{c.head}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td>
                <code>{r.name}</code>
              </td>
              <td>{REGION_NAMES[r.region] ?? <code>{r.region}</code>}</td>
              <td class="acc__num">{int(get(r, 'points') as number)}</td>
              {columns.map((c) => {
                const v = get(r, c.key);
                const over = c.key === 'contract' && typeof v === 'number' && v > 1;
                const shown = v === null ? [] : c.pair ? [parts(v), parts(get(r, c.pair))] : [parts(v)];
                return (
                  <td class:list={['acc__num', over && 'is-over']}>
                    {shown.map((p, i) => (
                      <>
                        {i > 0 && ' / '}
                        {p.m}
                        {p.e !== undefined && (
                          <>
                            {' '}× 10<sup>{p.e}</sup>
                          </>
                        )}
                      </>
                    ))}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
      {caption && <figcaption class="acc__caption">{caption}</figcaption>}
    </figure>
  )
}

<style>
  .acc {
    margin-inline: 0;
  }
  /* The per-function tables have many numeric columns; a step smaller
     keeps most of them inside the text column (the rest scroll). */
  .acc table {
    font-size: var(--text-sm);
  }
  .acc__num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .acc sup {
    font-size: 0.75em;
    line-height: 0;
  }
  .acc__ratio {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .is-over {
    color: var(--warn);
    font-weight: 600;
  }
  .acc__group td {
    color: var(--fg-muted);
  }
  .acc__sub {
    padding-left: 1.25em;
  }
  .acc__caption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-muted);
    text-align: center;
  }
</style>

---
/**
 * An array drawn as a grid of cells.
 *
 *   data   1-D or 2-D list of values (numbers or short strings)
 *   tones  same shape as data; one code per cell:
 *            ''  plain      'a' highlighted     'b' strongly highlighted
 *            'g' ghost (a value that is not stored, e.g. a broadcast copy)
 *            'm' muted (not part of the point being made)
 *   name   label above the grid, in the code font (e.g. "x")
 *   note   label below the grid (e.g. "shape (2, 3)")
 *   axes   show the "axis 0" / "axis 1" direction labels
 */
type Cell = string | number | boolean;
interface Props {
  data: Cell[] | Cell[][];
  tones?: string[] | string[][];
  name?: string;
  note?: string;
  axes?: boolean;
}
const { data, tones, name, note, axes = false } = Astro.props;
const is2d = Array.isArray(data[0]);
const rows = (is2d ? data : [data]) as Cell[][];
const toneRows = (tones ? (Array.isArray(tones[0]) ? tones : [tones]) : []) as string[][];
const cols = Math.max(...rows.map((r) => r.length), 1);
const show = (v: Cell) => (typeof v === 'boolean' ? (v ? 'True' : 'False') : String(v));
---

<div class="arr">
  {name && <span class="arr__name">{name}</span>}
  <div class:list={['arr__body', axes && 'arr__body--axes']}>
    {axes && is2d && (
      <span class="arr__axis arr__axis--0">
        axis 0<span>↓</span>
      </span>
    )}
    {axes && <span class="arr__axis arr__axis--1">{is2d ? 'axis 1 →' : 'axis 0 →'}</span>}
    <div class="arr__grid" style={`--cols:${cols}`}>
      {
        rows.map((row, r) =>
          row.map((v, c) => <span class:list={['arr__cell', toneRows[r]?.[c] && `arr__cell--${toneRows[r][c]}`]}>{show(v)}</span>),
        )
      }
    </div>
  </div>
  {note && <span class="arr__note">{note}</span>}
</div>

<style>
  .arr {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  .arr__name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.2;
    color: var(--fg);
  }
  .arr__note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.2;
    color: var(--fg-subtle);
    white-space: nowrap;
  }
  .arr__body--axes {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-rows: auto auto;
    gap: var(--space-1) var(--space-2);
    align-items: center;
  }
  .arr__axis {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--accent);
    white-space: nowrap;
  }
  .arr__axis--1 {
    grid-column: 2;
    grid-row: 1;
  }
  .arr__axis--0 {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }
  .arr__body--axes .arr__grid {
    grid-column: 2;
    grid-row: 2;
  }
  .arr__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(40px, auto));
    gap: 3px;
  }
  .arr__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding-inline: var(--space-2);
    border: 1px solid var(--line-strong);
    border-radius: 5px;
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1;
    color: var(--fg);
    white-space: nowrap;
  }
  .arr__cell--a {
    border-color: var(--blue-300);
    background: var(--blue-100);
    color: var(--blue-900);
  }
  .arr__cell--b {
    border-color: var(--blue-600);
    background: var(--blue-600);
    color: #fff;
  }
  .arr__cell--g {
    border-style: dashed;
    border-color: var(--slate-300);
    background: transparent;
    color: var(--slate-400);
  }
  .arr__cell--m {
    border-color: var(--line);
    background: transparent;
    color: var(--slate-400);
  }
</style>

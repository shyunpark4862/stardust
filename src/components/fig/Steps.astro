---
/**
 * A call path or pipeline drawn as a vertical rail of steps.
 *
 *   steps  [{ label, note?, where?, depth? }]
 *            label  what runs (shown in the code font)
 *            note   what it does
 *            where  file or layer it lives in (small tag on the right)
 *            depth  0 (default), 1 or 2: indent for a branch or sub-step
 *
 * Use inside <Fig column caption="...">.
 */
interface Step {
  label: string;
  note?: string;
  where?: string;
  depth?: number;
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<ol class="steps">
  {
    steps.map((s) => (
      <li class:list={['step', (s.depth ?? 0) > 0 && 'step--sub']} style={`--depth:${s.depth ?? 0}`}>
        <span class="step__dot" aria-hidden="true" />
        <div class="step__body">
          <div class="step__head">
            <code class="step__label">{s.label}</code>
            {s.where && <span class="step__where">{s.where}</span>}
          </div>
          {s.note && <p class="step__note">{s.note}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    width: 100%;
    max-width: 640px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Geometry. Every dot is centred on the rail (x = 6px) and on the first
     line of its box: border 1px + padding 8px + half of a 20.8px line. */
  .steps {
    --rail-x: 6px;
    --dot-y: 19px;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding-bottom: var(--space-3);
  }
  .step:last-child {
    padding-bottom: 0;
  }
  /* The rail: each step draws its own stretch, edge to edge, so the pieces
     meet without gaps; the first starts and the last ends at a dot's centre.
     The dots sit on top and hide the line where it passes through them.
     Sub-steps stay on the same rail; only their box is indented. */
  .step::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--rail-x) - 1px);
    width: 2px;
    border-radius: 1px;
    background: var(--blue-200);
  }
  .step:first-child::before {
    top: var(--dot-y);
  }
  .step:last-child::before {
    bottom: auto;
    height: var(--dot-y);
  }
  .step:only-child::before {
    display: none;
  }
  .step__dot {
    position: relative;
    z-index: 1;
    justify-self: center;
    width: 12px;
    height: 12px;
    margin-top: calc(var(--dot-y) - 6px);
    border: 2px solid var(--blue-500);
    border-radius: 50%;
    background: var(--bg);
  }
  .step--sub .step__dot {
    width: 8px;
    height: 8px;
    margin-top: calc(var(--dot-y) - 4px);
    border-width: 1.5px;
    border-color: var(--blue-400);
  }
  .step__body {
    margin-left: calc(var(--depth) * var(--space-6));
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg);
  }
  .step__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
  }
  .step__label {
    padding: 0;
    border: 0;
    background: none;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.6;
    color: var(--fg);
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .step__where {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--accent);
    white-space: nowrap;
  }
  .step__note {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-muted);
  }
</style>

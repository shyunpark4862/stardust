---
/** An operator or arrow between two arrays in a Fig: "+", "=", "→". */
interface Props {
  /** Small text under the symbol, e.g. "axis=0". */
  note?: string;
}
const { note } = Astro.props;
---

<span class="op">
  <span class="op__sym"><slot /></span>
  {note && <span class="op__note">{note}</span>}
</span>

<style>
  .op {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding-inline: var(--space-1);
  }
  .op__sym {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--slate-400);
  }
  .op__note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.2;
    color: var(--fg-subtle);
    white-space: nowrap;
  }
</style>

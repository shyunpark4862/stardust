---
/** An operator or arrow between two arrays in a Fig: "+", "=", "→". */
interface Props {
  /** Small text under the symbol, e.g. "axis=0". */
  note?: string;
}
const { note } = Astro.props;
---

<span class="op">
  <span class="op__sym"><slot /></span>
  {note && <span class="op__note">{note}</span>}
</span>

<style>
  /* The note hangs below the symbol without taking space, so the symbol
     itself is what lines up with the middle of the neighbouring grids. */
  .op {
    position: relative;
    display: inline-flex;
    justify-content: center;
    padding-inline: var(--space-1);
  }
  .op__sym {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--slate-400);
  }
  .op__note {
    position: absolute;
    top: calc(100% + var(--space-1));
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.2;
    color: var(--fg-subtle);
    white-space: nowrap;
  }
</style>

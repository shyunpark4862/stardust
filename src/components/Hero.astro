---
import Button from './Button.astro';
---

<section class="hero" data-surface="dark" data-hero>
  <div class="hero__sky" aria-hidden="true">
    <div class="hero__glow"></div>
    <div class="hero__core"></div>
    <canvas class="hero__canvas"></canvas>
    <div class="hero__veil"></div>
  </div>

  <div class="container hero__inner">
    <p class="eyebrow hero__eyebrow">Array · Linear algebra · Sparse · DataFrame · Special · Stats · Tests · Regression · Optimize · Calculus · Random</p>
    <h1 class="hero__title">
      <span class="hero__line">Numerics, rebuilt</span>
      <span class="hero__line hero__line--accent">down to the last bit.</span>
    </h1>
    <p class="hero__lead">
      stardust는 배열과 선형대수부터 통계와 난수까지, 수치 계산의 기본기를 C++20으로 처음부터 다시 만든 Python 라이브러리예요. 모든 영역이 같은
      규칙으로 움직이고, 같은 기계에서 같은 입력이면 몇 번을 돌려도 결과가 비트까지 같아요.
    </p>
    <div class="hero__actions">
      <Button href="/intro/" size="lg" arrow>소개 읽기</Button>
      <Button href="/api/" size="lg" variant="secondary">API 살펴보기</Button>
    </div>
  </div>

  <!-- The run's clock, shown while the merger backdrop is in use. It
       changes many times a second, so it is kept from screen readers. -->
  <div class="container hero__sim" aria-hidden="true">
    <dl class="sim">
      <div class="sim__item">
        <dt>Elapsed</dt>
        <dd><span data-sim-time>0.00</span><small>억 년</small></dd>
      </div>
      <div class="sim__item">
        <dt>Pace</dt>
        <dd><span data-sim-rate>0</span><small>만 년/초</small></dd>
      </div>
      <div class="sim__item sim__item--phase">
        <dt>Phase</dt>
        <dd data-sim-phase>Approach</dd>
      </div>
    </dl>
  </div>

</section>

<script>
  // Two backdrops: the galaxy (1) and two galaxies merging into it (2).
  // "?sky=1" or "?sky=2" in the address picks one for comparison.
  const SKY = 2;

  const host = document.querySelector<HTMLElement>('.hero');
  const canvas = document.querySelector<HTMLCanvasElement>('.hero__canvas');
  if (host && canvas) {
    const asked = Number(new URLSearchParams(location.search).get('sky'));
    if ((asked || SKY) === 2) {
      import('../scripts/stardust-merge').then((m) => m.mountMerger(canvas, host));
    } else {
      import('../scripts/stardust').then((m) => m.mountStardust(canvas, host));
    }
  }
</script>

<style>
  .hero {
    --core-x: 70%;
    --core-y: 53%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: max(100svh, 680px);
    padding-top: var(--header-h);
    background: var(--night-950);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---- Backdrop ---- */
  .hero__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(90rem 50rem at 80% 110%, rgb(28 68 184 / 0.28), transparent 70%),
      linear-gradient(180deg, var(--night-950), var(--night-900) 60%, #07102a);
  }
  /* The light around the core of the galaxy. While two galaxies are still
     merging there is no core yet, and it waits. */
  .hero__core {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(38rem 24rem at var(--core-x) var(--core-y), rgb(72 118 255 / 0.18), transparent 70%),
      radial-gradient(12rem 8rem at var(--core-x) var(--core-y), rgb(255 228 196 / 0.14), transparent 70%);
    transition: opacity 5s var(--ease);
  }
  .hero[data-merging] .hero__core {
    opacity: 0.25;
    transition: none;
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1200ms var(--ease);
  }
  .hero__canvas:global(.is-ready) {
    opacity: 1;
  }
  /* Keeps the copy legible where the disc passes behind it. */
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(4 8 22 / 0.72), rgb(4 8 22 / 0.3) 42%, transparent 62%),
      linear-gradient(0deg, var(--night-950), rgb(4 8 22 / 0.6) 10%, transparent 30%);
  }

  /* ---- Copy ---- */
  .hero__inner {
    padding-block: var(--space-20) var(--space-24);
  }
  .hero__title {
    margin-top: var(--space-6);
    font-size: clamp(2.5rem, 6.4vw, 5.25rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.045em;
    text-wrap: nowrap;
  }
  .hero__line {
    display: block;
  }
  .hero__line--accent {
    padding-bottom: 0.1em; /* room for descenders under background-clip */
    background: linear-gradient(92deg, #ffffff 0%, var(--blue-200) 38%, var(--blue-400) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lead {
    max-width: 34rem;
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--fg-muted);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-10);
  }

  /* ---- Simulation readout ---- */
  .hero__sim {
    position: absolute;
    inset: auto 0 0;
    display: none;
    justify-content: flex-end;
    padding-block: var(--space-8);
    pointer-events: none;
  }
  .hero[data-sim] .hero__sim {
    display: flex;
    transition:
      opacity 1.6s var(--ease),
      visibility 0s linear 1.6s;
  }
  /* The run has settled into the steady galaxy: the clock is no longer news. */
  .hero[data-sim-done] .hero__sim {
    opacity: 0;
    visibility: hidden;
  }
  .sim {
    display: flex;
    gap: var(--space-8);
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .sim__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .sim dt {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .sim dd {
    margin: 0;
    font-size: var(--text-base);
    color: var(--fg);
    white-space: nowrap;
  }
  .sim small {
    margin-left: 0.2em;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  /* Wide enough for the longest value, so the row does not shift. */
  .sim__item:nth-child(1) dd {
    min-width: 10ch;
  }
  .sim__item:nth-child(2) dd {
    min-width: 13ch;
  }
  .sim__item--phase dd {
    min-width: 16ch;
  }

  /* ---- Entrance ---- */
  .hero__eyebrow,
  .hero__line,
  .hero__lead,
  .hero__actions {
    animation: rise 1100ms var(--ease) backwards;
  }
  .hero__eyebrow {
    animation-delay: 150ms;
  }
  .hero__line:nth-child(1) {
    animation-delay: 250ms;
  }
  .hero__line:nth-child(2) {
    animation-delay: 380ms;
  }
  .hero__lead {
    animation-delay: 560ms;
  }
  .hero__actions {
    animation-delay: 680ms;
  }
  /* The entrance starts from a faint, not an invisible, state: where
     animations never run (a background tab, print, some readers) the text
     is still there to read. */
  @keyframes rise {
    from {
      opacity: 0.25;
      transform: translateY(18px);
    }
  }

  @media (max-width: 800px) {
    .hero {
      justify-content: flex-start;
    }
    .hero__inner {
      padding-block: var(--space-16) var(--space-32);
    }
    .hero__title {
      text-wrap: balance;
    }
    .hero__veil {
      background: linear-gradient(180deg, rgb(4 8 22 / 0.7), rgb(4 8 22 / 0.2) 55%, rgb(4 8 22 / 0.5));
    }
    .hero__sim {
      justify-content: flex-start;
      padding-block: var(--space-5);
    }
    .sim {
      gap: var(--space-5);
    }
    .sim__item--phase {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow,
    .hero__line,
    .hero__lead,
    .hero__actions {
      animation: none;
    }
  }
</style>

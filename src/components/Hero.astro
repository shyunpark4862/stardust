---
import Button from './Button.astro';
---

<section class="hero" data-surface="dark" data-hero>
  <div class="hero__sky" aria-hidden="true">
    <div class="hero__glow"></div>
    <canvas class="hero__canvas"></canvas>
    <div class="hero__veil"></div>
  </div>

  <div class="container hero__inner">
    <p class="eyebrow hero__eyebrow">Array · Linear algebra · DataFrame · Special · Stats · Regression · Random</p>
    <h1 class="hero__title">
      <span class="hero__line">Numerics, rebuilt</span>
      <span class="hero__line hero__line--accent">down to the last bit.</span>
    </h1>
    <p class="hero__lead">
      stardust는 배열과 선형대수부터 통계와 난수까지, 수치 계산의 기본기를 C++20으로 처음부터 다시 만든 Python 라이브러리예요. 모든 영역이 같은
      규칙으로 움직이고, 스레드를 몇 개 쓰든 결과는 비트까지 같아요.
    </p>
    <div class="hero__actions">
      <Button href="/intro/" size="lg" arrow>소개 읽기</Button>
      <Button href="/api/" size="lg" variant="secondary">API 살펴보기</Button>
    </div>
  </div>

  <div class="container hero__foot">
    <ul class="hero__facts">
      <li>C++20 core</li>
      <li>nanobind</li>
      <li>NEON</li>
      <li>Accelerate</li>
    </ul>
    <a class="hero__scroll" href="#strengths">
      <span>Scroll</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </a>
  </div>
</section>

<script>
  import { mountStardust } from '../scripts/stardust';

  const host = document.querySelector<HTMLElement>('.hero');
  const canvas = document.querySelector<HTMLCanvasElement>('.hero__canvas');
  if (host && canvas) mountStardust(canvas, host);
</script>

<style>
  .hero {
    --core-x: 70%;
    --core-y: 53%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: max(100svh, 680px);
    padding-top: var(--header-h);
    background: var(--night-950);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---- Backdrop ---- */
  .hero__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(38rem 22rem at var(--core-x) var(--core-y), rgb(72 118 255 / 0.22), transparent 70%),
      radial-gradient(14rem 8rem at var(--core-x) var(--core-y), rgb(190 214 255 / 0.2), transparent 70%),
      radial-gradient(90rem 50rem at 80% 110%, rgb(28 68 184 / 0.28), transparent 70%),
      linear-gradient(180deg, var(--night-950), var(--night-900) 60%, #07102a);
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1200ms var(--ease);
  }
  .hero__canvas:global(.is-ready) {
    opacity: 1;
  }
  /* Keeps the copy legible where the disc passes behind it. */
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(4 8 22 / 0.72), rgb(4 8 22 / 0.3) 42%, transparent 62%),
      linear-gradient(0deg, var(--night-950), rgb(4 8 22 / 0.6) 10%, transparent 30%);
  }

  /* ---- Copy ---- */
  .hero__inner {
    padding-block: var(--space-20) var(--space-32);
  }
  .hero__title {
    margin-top: var(--space-6);
    font-size: clamp(2.5rem, 6.4vw, 5.25rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.045em;
    text-wrap: nowrap;
  }
  .hero__line {
    display: block;
  }
  .hero__line--accent {
    padding-bottom: 0.1em; /* room for descenders under background-clip */
    background: linear-gradient(92deg, #ffffff 0%, var(--blue-200) 38%, var(--blue-400) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lead {
    max-width: 34rem;
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--fg-muted);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-10);
  }

  /* ---- Foot ---- */
  .hero__foot {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-8);
  }
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--fg-subtle);
  }
  .hero__facts li + li::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin-right: var(--space-6);
    border-radius: 50%;
    background: currentColor;
    vertical-align: middle;
    opacity: 0.6;
  }
  .hero__scroll {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-subtle);
    transition: color var(--dur-fast) var(--ease);
  }
  .hero__scroll:hover {
    color: var(--fg);
  }
  .hero__scroll-line {
    position: relative;
    width: 48px;
    height: 1px;
    background: var(--line-strong);
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--fg);
    transform: translateX(-100%);
    animation: scroll-cue 2.4s var(--ease) infinite;
  }
  @keyframes scroll-cue {
    0% {
      transform: translateX(-100%);
    }
    60%,
    100% {
      transform: translateX(100%);
    }
  }

  /* ---- Entrance ---- */
  .hero__eyebrow,
  .hero__line,
  .hero__lead,
  .hero__actions,
  .hero__foot {
    animation: rise 1100ms var(--ease) backwards;
  }
  .hero__eyebrow {
    animation-delay: 150ms;
  }
  .hero__line:nth-child(1) {
    animation-delay: 250ms;
  }
  .hero__line:nth-child(2) {
    animation-delay: 380ms;
  }
  .hero__lead {
    animation-delay: 560ms;
  }
  .hero__actions {
    animation-delay: 680ms;
  }
  .hero__foot {
    animation-name: fade;
    animation-delay: 1200ms;
  }
  /* The entrance starts from a faint, not an invisible, state: where
     animations never run (a background tab, print, some readers) the text
     is still there to read. */
  @keyframes rise {
    from {
      opacity: 0.25;
      transform: translateY(18px);
    }
  }
  @keyframes fade {
    from {
      opacity: 0.25;
    }
  }

  @media (max-width: 800px) {
    .hero {
      justify-content: flex-start;
    }
    .hero__inner {
      padding-block: var(--space-16) var(--space-32);
    }
    .hero__title {
      text-wrap: balance;
    }
    .hero__veil {
      background: linear-gradient(180deg, rgb(4 8 22 / 0.7), rgb(4 8 22 / 0.2) 55%, rgb(4 8 22 / 0.5));
    }
    .hero__scroll {
      display: none;
    }
    .hero__facts {
      flex-wrap: nowrap;
      gap: var(--space-3);
      white-space: nowrap;
    }
    .hero__facts li + li::before {
      margin-right: var(--space-3);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow,
    .hero__line,
    .hero__lead,
    .hero__actions,
    .hero__foot,
    .hero__scroll-line::after {
      animation: none;
    }
  }
</style>

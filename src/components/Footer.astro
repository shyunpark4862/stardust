---
import Logo from './Logo.astro';
import { topNav } from '../data/nav';
---

<footer class="footer">
  <div class="container footer__inner">
    <div>
      <Logo />
      <p class="footer__note">배열, 선형대수, 데이터프레임을 처음부터 다시 만든 Python 라이브러리.</p>
    </div>
    <nav class="footer__nav" aria-label="바닥 메뉴">
      {topNav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--bg-subtle);
  }
  .footer__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-8);
    padding-block: var(--space-12);
  }
  .footer__note {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--fg-subtle);
  }
  .footer__nav {
    display: flex;
    gap: var(--space-6);
    font-size: var(--text-base);
    color: var(--fg-muted);
  }
  .footer__nav a:hover {
    color: var(--fg);
  }
  @media (max-width: 640px) {
    .footer__inner {
      flex-direction: column;
    }
  }
</style>

---
/**
 * A small line drawing for an area card on the landing page: what the area
 * works with, in the area's colour. Decorative only.
 */
interface Props {
  area: string;
}
const { area } = Astro.props;

// Bell curve and gamma-like curve, sampled once at build time.
const pts = (f: (x: number) => number, x0: number, x1: number, n = 48) =>
  Array.from({ length: n + 1 }, (_, i) => {
    const x = x0 + ((x1 - x0) * i) / n;
    return [x, f(x)] as const;
  });
const path = (p: readonly (readonly [number, number])[]) =>
  p.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const bell = pts((x) => 56 - 44 * Math.exp(-(((x - 80) / 18) ** 2)), 20, 140);
const gamma = pts((x) => {
  const t = (x - 16) / 22;
  return 58 - 46 * (t > 0 ? t * Math.exp(1 - t) : 0);
}, 16, 150);
// Fixed pseudo-random points so every build draws the same picture.
const rand = (seed: number) => () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const r1 = rand(7);
const dots = Array.from({ length: 34 }, () => [16 + r1() * 136, 8 + r1() * 50, 0.35 + r1() * 0.65]);
// A banded matrix with a few stray entries: only the stored cells are drawn.
const r3 = rand(11);
const sparseCells = Array.from({ length: 5 }, (_, r) =>
  Array.from({ length: 10 }, (_, c) => [r, c] as const).filter(([rr, c]) => Math.abs(c - 2 * rr - 0.5) < 1.6 || r3() < 0.06),
)
  .flat()
  .map(([r, c]) => [r, c, Math.abs(c - 2 * r - 0.5) < 1.6 ? 0.75 : 0.35] as const);
// A heavy-tailed null density for the test card.
const tdist = pts((x) => 56 - 44 / (1 + ((x - 72) / 16) ** 2) ** 1.5, 16, 150);
const r2 = rand(3);
const scatter = Array.from({ length: 16 }, (_, i) => {
  const x = 20 + i * 8 + r2() * 4;
  return [x, 54 - (x - 20) * 0.3 + (r2() - 0.5) * 14];
});
---

<svg class="art" viewBox="0 0 168 64" preserveAspectRatio="xMinYMid meet" aria-hidden="true">
  {
    area === 'array' &&
      [0, 1, 2].map((r) =>
        [0, 1, 2, 3, 4, 5].map((c) => (
          <rect x={16 + c * 22} y={6 + r * 19} width="17" height="15" rx="3" fill="var(--area)" opacity={0.12 + ((r * 6 + c) % 7) * 0.11} />
        )),
      )
  }
  {
    area === 'linalg' && (
      <g fill="none" stroke="var(--area)" stroke-width="1.6" stroke-linecap="round">
        <path d="M22 6h-6v52h6M98 6h6v52h-6" />
        {[0, 1, 2, 3].map((i) =>
          [0, 1, 2, 3].map((j) => (
            <circle cx={30 + j * 20} cy={13 + i * 13} r={i === j ? 4 : j > i ? 2.4 : 1.4} fill="var(--area)" stroke="none" opacity={i === j ? 1 : j > i ? 0.5 : 0.25} />
          )),
        )}
        <path d="M118 32h18m-6-6 6 6-6 6" />
        <path d="M148 10v44" opacity="0.4" />
      </g>
    )
  }
  {
    area === 'sparse' && (
      <g>
        <rect x="16" y="6" width="104" height="52" rx="3" fill="none" stroke="var(--line-strong)" stroke-width="1" />
        {sparseCells.map(([r, c, o]) => (
          <rect x={19 + c * 10} y={9 + r * 10} width="7" height="7" rx="1.5" fill="var(--area)" opacity={o} />
        ))}
        <path d="M128 32h12m-5-5 5 5-5 5" fill="none" stroke="var(--area)" stroke-width="1.6" stroke-linecap="round" />
        {[0, 1, 2].map((i) => (
          <rect x="146" y={14 + i * 13} width="8" height="8" rx="1.5" fill="var(--area)" opacity={0.85 - i * 0.2} />
        ))}
      </g>
    )
  }
  {
    area === 'htest' && (
      <g>
        <path d={`M110 ${tdist.find(([x]) => x >= 110)![1].toFixed(1)} ${path(tdist.filter(([x]) => x >= 110)).replace(/^M/, 'L')} L150 56 L110 56 Z`} fill="var(--area)" opacity="0.22" />
        <path d={path(tdist)} fill="none" stroke="var(--area)" stroke-width="2" stroke-linecap="round" />
        <path d="M16 56H152" stroke="var(--line-strong)" stroke-width="1" />
        <path d="M122 60V20" stroke="var(--area)" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="3 3" />
        <circle cx="122" cy="20" r="3" fill="var(--area)" />
      </g>
    )
  }
  {
    area === 'frame' && (
      <g>
        <rect x="16" y="6" width="136" height="12" rx="3" fill="var(--area)" opacity="0.85" />
        {[0, 1, 2].map((r) => (
          <g>
            {[0, 1, 2, 3].map((c) => (
              <rect x={16 + c * 35} y={24 + r * 13} width={c === 0 ? 22 : 30} height="8" rx="2" fill="var(--area)" opacity={r === 1 && c === 2 ? 0.08 : 0.22} />
            ))}
          </g>
        ))}
        <text x="92" y="44" font-size="7" font-family="var(--font-mono)" fill="var(--area)">NA</text>
      </g>
    )
  }
  {
    area === 'special' && (
      <g fill="none" stroke-linecap="round">
        <path d="M16 58H156M16 58V6" stroke="var(--line-strong)" stroke-width="1" />
        <path d={path(gamma)} stroke="var(--area)" stroke-width="2" />
        <path d={path(gamma.map(([x, y]) => [x, 58 - (58 - y) * 0.55]))} stroke="var(--area)" stroke-width="1.4" opacity="0.45" />
      </g>
    )
  }
  {
    area === 'stats' && (
      <g>
        <path d={`${path(bell.filter(([x]) => x <= 92))} L92 56 L20 56 Z`} fill="var(--area)" opacity="0.16" />
        <path d={path(bell)} fill="none" stroke="var(--area)" stroke-width="2" stroke-linecap="round" />
        <path d="M16 56H148" stroke="var(--line-strong)" stroke-width="1" />
      </g>
    )
  }
  {
    area === 'regression' && (
      <g>
        {scatter.map(([x, y]) => (
          <circle cx={x} cy={y} r="2.6" fill="var(--area)" opacity="0.45" />
        ))}
        <path d="M16 56L156 14" stroke="var(--area)" stroke-width="2" stroke-linecap="round" />
      </g>
    )
  }
  {
    area === 'optimize' && (
      <g>
        {[0.35, 0.65, 1].map((k) => (
          <ellipse cx="104" cy="34" rx={52 * k} ry={24 * k} fill="none" stroke="var(--area)" stroke-width="1" opacity={0.25 + 0.2 * (1 - k)} transform="rotate(-12 104 34)" />
        ))}
        <path d="M30 52L58 22L80 46L94 27L101 37L104 34" fill="none" stroke="var(--area)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        {[[30, 52], [58, 22], [80, 46], [94, 27], [101, 37]].map(([x, y]) => (
          <circle cx={x} cy={y} r="2.4" fill="var(--area)" opacity="0.55" />
        ))}
        <circle cx="104" cy="34" r="3.6" fill="var(--area)" />
      </g>
    )
  }
  {
    area === 'random' &&
      dots.map(([x, y, o]) => <circle cx={x} cy={y} r={1 + o * 1.8} fill="var(--area)" opacity={o * 0.8} />)
  }
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: 64px;
    margin-bottom: var(--space-5);
  }
</style>

---
/*
 * An aside inside a document. All three types share one neutral box; only the
 * icon and the label carry the type's colour, so a page with several callouts
 * stays calm.
 */
interface Props {
  type?: 'note' | 'tip' | 'warn';
  title?: string;
}
const { type = 'note', title } = Astro.props;
const labels = { note: '참고', tip: '팁', warn: '주의' };
---

<aside class:list={['callout', `callout--${type}`]}>
  <svg class="callout__icon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
    {
      type === 'note' && (
        <g>
          <circle cx="9" cy="9" r="7.25" />
          <path d="M9 8.25v4M9 5.6v.15" />
        </g>
      )
    }
    {
      type === 'tip' && (
        <g>
          <path d="M6.6 12.2a4.75 4.75 0 1 1 4.8 0v1.3H6.6v-1.3Z" />
          <path d="M7.4 16h3.2" />
        </g>
      )
    }
    {
      type === 'warn' && (
        <g>
          <path d="M9 2.4 16.2 15H1.8L9 2.4Z" />
          <path d="M9 7.25v3.5M9 12.75v.15" />
        </g>
      )
    }
  </svg>
  <div class="callout__content">
    <p class="callout__title">{title ?? labels[type]}</p>
    <div class="callout__body"><slot /></div>
  </div>
</aside>

<style>
  .callout {
    --c: var(--accent);
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-subtle);
  }
  .callout--warn {
    --c: var(--warn);
  }
  .callout__icon {
    /* Optically centred on the title's first line. */
    margin-top: 2px;
    stroke: var(--c);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .callout__title {
    font-size: var(--text-base);
    font-weight: 650;
    line-height: 22px;
    color: var(--fg);
  }
  .callout__body {
    margin-top: var(--space-1);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--fg-muted);
  }
  .callout__body :global(> * + *) {
    margin-top: var(--space-2);
  }
  .callout__body :global(:not(pre) > code) {
    background: var(--bg);
  }
</style>

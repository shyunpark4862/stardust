---
/**
 * "함께 보기" at the end of a reference page or an article: related pages,
 * one per row, with their summaries.
 */
import { inlineHtml } from '../../data/inline';

interface Item {
  href: string;
  title: string;
  summary: string;
  /** Show the title in the code font (a single function's page). */
  mono?: boolean;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <>
      <h2 id="함께-보기">함께 보기</h2>
      <ul class="related">
        {items.map((item) => (
          <li>
            <a class="related__link" href={item.href}>
              <span class:list={['related__name', item.mono && 'related__name--mono']}>{item.title}</span>
              <span class="related__summary" set:html={inlineHtml(item.summary)} />
            </a>
          </li>
        ))}
      </ul>
    </>
  )
}

<style>
  .related {
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .related li {
    margin: 0;
  }
  .related__link {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }
  .related__name {
    font-weight: 600;
    color: var(--accent);
  }
  .related__name--mono {
    font-family: var(--font-mono);
  }
  .related__link:hover .related__name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .related__summary {
    color: var(--fg-muted);
  }
  @media (max-width: 640px) {
    .related__link {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
  }
</style>

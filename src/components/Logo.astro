    <g fill="currentColor">
      <circle cx="10" cy="10" r="2.4"></circle>
      <circle cx="16.4" cy="4.6" r="1.2" opacity=".8"></circle>
      <circle cx="3.8" cy="14.6" r="1" opacity=".65"></circle>
      <circle cx="15.2" cy="15.6" r=".8" opacity=".5"></circle>
      <circle cx="5" cy="4.8" r=".7" opacity=".45"></circle>
    </g>

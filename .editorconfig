# Editor defaults; the formatters (tools/format.py) decide the rest.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi,cpp,hpp,h,cc}]
max_line_length = 120

[{CMakeLists.txt,*.cmake}]
indent_size = 2

[*.{yml,yaml,toml}]
indent_size = 2

# Markdown: a trailing double space is a line break.
[*.md]
trim_trailing_whitespace = false

# Data and reference files are kept byte for byte.
[*.{json,npz,dat,log,txt,csv,f}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# Vendored and generated sources are not touched.
[third_party/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
charset = unset
end_of_line = unset

[{csrc/special/coeffs/**,csrc/stats/coeffs/**,csrc/frame/ops/pow5_table.hpp,csrc/*/cost_table.hpp}]
insert_final_newline = unset
trim_trailing_whitespace = unset

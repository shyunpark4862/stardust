---
/**
 * A small function plot, drawn at build time.
 *
 *   curves  [{ f: (x) => y, label, dashed? }]   up to three
 *           or [{ points: [[x, y], ...], label, dashed? }] for values computed
 *           elsewhere (e.g. special functions JavaScript has no formula for);
 *           the points are joined in order, a NaN or out-of-frame y lifts the pen
 *   domain  [x0, x1]        range  [y0, y1]
 *   xTicks / yTicks  [{ v, label }]  grid lines with labels
 */
interface Curve {
  f?: (x: number) => number;
  points?: [number, number][];
  label: string;
  dashed?: boolean;
}
interface Tick {
  v: number;
  label: string;
}
interface Props {
  curves: Curve[];
  domain: [number, number];
  range: [number, number];
  xTicks?: Tick[];
  yTicks?: Tick[];
}
const { curves, domain, range, xTicks = [], yTicks = [] } = Astro.props;

const W = 640;
const H = 260;
const pad = { l: 48, r: 16, t: 16, b: 32 };

// Sampled points of every curve, in data units.
const sampled: [number, number][][] = curves.map(
  (c) =>
    c.points ??
    Array.from({ length: 481 }, (_, i) => {
      const x = domain[0] + ((domain[1] - domain[0]) * i) / 480;
      return [x, c.f!(x)] as [number, number];
    }),
);
const inFrame = (y: number) => Number.isFinite(y) && y >= range[0] && y <= range[1];
// Name the lines at their right ends when every line reaches the right edge
// and the names are short; otherwise keep the legend under the plot.
const ends = sampled.map((pts) => [...pts].reverse().find(([, y]) => inFrame(y)));
const span = domain[1] - domain[0];
const direct =
  curves.length > 1 &&
  curves.every((c, i) => c.label.length <= 10 && ends[i] !== undefined && ends[i]![0] >= domain[1] - span * 0.04);
const labelW = direct ? Math.max(...curves.map((c) => c.label.length)) * 7.6 + 14 : 0;
pad.r += labelW;
const sx = (x: number) => pad.l + ((x - domain[0]) / (domain[1] - domain[0])) * (W - pad.l - pad.r);
const sy = (y: number) => H - pad.b - ((y - range[0]) / (range[1] - range[0])) * (H - pad.t - pad.b);

// Sample each curve; start a new stroke wherever the value leaves the frame
// (a pole of tan, the edge of acos's domain) so no line is drawn across the gap.
function pathOf(i: number): string {
  const pts = sampled[i];
  const slack = (range[1] - range[0]) * 0.02;
  let d = '';
  let pen = false;
  for (const [x, y] of pts) {
    const ok = Number.isFinite(y) && y >= range[0] - slack && y <= range[1] + slack;
    if (!ok) {
      pen = false;
      continue;
    }
    d += `${pen ? 'L' : 'M'}${sx(x).toFixed(1)} ${sy(y).toFixed(1)}`;
    pen = true;
  }
  return d;
}
// Label positions: at each line's end, pushed apart so they never overlap.
const labelY = (() => {
  if (!direct) return [];
  const order = ends.map((e, i) => ({ i, y: sy(e![1]) })).sort((a, b) => a.y - b.y);
  const gap = 15;
  for (let k = 1; k < order.length; k++) order[k].y = Math.max(order[k].y, order[k - 1].y + gap);
  const over = order[order.length - 1].y - (H - pad.b);
  if (over > 0) for (const o of order) o.y -= over;
  for (let k = 0; k < order.length; k++) order[k].y = Math.max(order[k].y, pad.t + 4 + k * gap);
  const out: number[] = [];
  for (const o of order) out[o.i] = o.y;
  return out;
})();

// Data for the hover readout: about 160 points a line is enough to read
// values to the plot's own precision.
const thin = (pts: [number, number][]) => {
  const step = Math.max(1, Math.floor(pts.length / 160));
  return pts.filter((_, i) => i % step === 0 || i === pts.length - 1).map(([x, y]) => [+x.toPrecision(6), Number.isFinite(y) ? +y.toPrecision(6) : null]);
};
// A log axis is drawn in exponents with ticks labeled 10^v ("0.001", "1e6"):
// read such an axis back as 10^x so the readout speaks in the plot's units.
const isLog = (ticks: Tick[]) =>
  ticks.length >= 2 &&
  ticks.every((t) => {
    if (typeof t.label !== 'string' || t.label === '') return false;
    const n = Number(t.label.replace(/[−–]/g, '-').replace(/\s/g, ''));
    return Number.isFinite(n) && n > 0 && Math.abs(n - 10 ** t.v) <= 1e-9 * 10 ** t.v && t.v !== Math.round(n);
  }) &&
  ticks.some((t) => t.v !== 0 && t.v !== 1);
const readout = JSON.stringify({
  lx: isLog(xTicks) ? 1 : 0,
  ly: isLog(yTicks) ? 1 : 0,
  W,
  H,
  pad,
  d: domain,
  r: range,
  c: curves.map((c, i) => [c.label, thin(sampled[i])]),
});
const zeroX = domain[0] <= 0 && domain[1] >= 0;
const zeroY = range[0] <= 0 && range[1] >= 0;
---

<div class="plot" data-plot={readout}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Plot of ${curves.map((c) => c.label).join(', ')}`}>
    {xTicks.map((t) => <line class="plot__grid" x1={sx(t.v)} x2={sx(t.v)} y1={pad.t} y2={H - pad.b} />)}
    {yTicks.map((t) => <line class="plot__grid" x1={pad.l} x2={W - pad.r} y1={sy(t.v)} y2={sy(t.v)} />)}
    {zeroY && <line class="plot__axis" x1={pad.l} x2={W - pad.r} y1={sy(0)} y2={sy(0)} />}
    {zeroX && <line class="plot__axis" x1={sx(0)} x2={sx(0)} y1={pad.t} y2={H - pad.b} />}
    {xTicks.map((t) => <text class="plot__tick" x={sx(t.v)} y={H - 10} text-anchor="middle">{t.label}</text>)}
    {yTicks.map((t) => <text class="plot__tick" x={pad.l - 8} y={sy(t.v) + 4} text-anchor="end">{t.label}</text>)}
    {curves.map((c, i) => <path class:list={['plot__curve', `plot__curve--${i}`, c.dashed && 'plot__curve--dashed']} d={pathOf(i)} />)}
    {
      direct &&
        curves.map((c, i) => (
          <text class:list={['plot__name', `plot__name--${i}`]} x={W - pad.r + 8} y={labelY[i] + 4}>
            {c.label}
          </text>
        ))
    }
    <g class="plot__hover" aria-hidden="true">
      <line class="plot__cross" x1="0" x2="0" y1={pad.t} y2={H - pad.b} />
      {curves.map((_, i) => <circle class:list={['plot__dot', `plot__dot--${i}`]} r="3.5" cx="0" cy="0" />)}
    </g>
  </svg>
  <div class="plot__tip" aria-hidden="true"></div>
  <ul class:list={['plot__legend', direct && 'plot__legend--sr']}>
    {
      curves.map((c, i) => (
        <li>
          <span class:list={['plot__swatch', `plot__swatch--${i}`]} />
          {c.label}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .plot {
    position: relative;
    width: 100%;
    max-width: 640px;
  }
  .plot svg {
    width: 100%;
    height: auto;
  }
  .plot__grid {
    stroke: var(--line);
    stroke-width: 1;
  }
  .plot__axis {
    stroke: var(--slate-400);
    stroke-width: 1;
  }
  .plot__tick {
    fill: var(--fg-subtle);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .plot__name {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
  }
  .plot__name--0 {
    fill: var(--blue-600);
  }
  .plot__name--1 {
    fill: var(--blue-400);
  }
  .plot__name--2 {
    fill: var(--slate-500);
  }
  /* Hover readout: a vertical line, a dot on each curve, the values. */
  .plot__hover {
    visibility: hidden;
    pointer-events: none;
  }
  .plot.is-reading .plot__hover {
    visibility: visible;
  }
  .plot__cross {
    stroke: var(--slate-400);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }
  .plot__dot {
    stroke: var(--bg);
    stroke-width: 2;
  }
  .plot__dot--0 {
    fill: var(--blue-600);
  }
  .plot__dot--1 {
    fill: var(--blue-300);
  }
  .plot__dot--2 {
    fill: var(--slate-400);
  }
  .plot__tip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
    box-shadow: var(--shadow-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--fg-muted);
    white-space: nowrap;
    pointer-events: none;
    visibility: hidden;
  }
  .plot.is-reading .plot__tip {
    visibility: visible;
  }
  .plot__tip :global(b) {
    font-weight: 600;
    color: var(--fg);
  }
  .plot__tip :global(i) {
    display: inline-block;
    width: 10px;
    height: 2px;
    margin-right: 6px;
    vertical-align: middle;
    border-radius: 1px;
  }
  .plot__curve {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .plot__curve--0 {
    stroke: var(--blue-600);
  }
  .plot__curve--1 {
    stroke: var(--blue-300);
  }
  .plot__curve--2 {
    stroke: var(--slate-400);
  }
  .plot__curve--dashed {
    stroke-dasharray: 5 5;
  }
  .plot__legend {
    display: flex;
    justify-content: center;
    gap: var(--space-5);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }
  .plot__legend li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }
  .plot__swatch {
    width: 14px;
    height: 2px;
    border-radius: 1px;
  }
  .plot__swatch--0 {
    background: var(--blue-600);
  }
  .plot__swatch--1 {
    background: var(--blue-300);
  }
  .plot__swatch--2 {
    background: var(--slate-400);
  }
  /* Named on the plot: the legend stays for screen readers only. */
  .plot__legend--sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  // Hover readout for every plot on the page. Values are read off the sampled
  // points (linear between neighbors), so they match the drawn lines.
  const colors = ['var(--blue-600)', 'var(--blue-300)', 'var(--slate-400)'];
  const fmt = (v: number) => {
    if (v === 0) return '0';
    const a = Math.abs(v);
    return a >= 1e5 || a < 1e-3 ? v.toExponential(3) : String(+v.toPrecision(4));
  };
  document.querySelectorAll<HTMLElement>('.plot[data-plot]').forEach((box) => {
    const data = JSON.parse(box.dataset.plot!);
    const svg = box.querySelector('svg')!;
    const cross = box.querySelector<SVGLineElement>('.plot__cross')!;
    const dots = [...box.querySelectorAll<SVGCircleElement>('.plot__dot')];
    const tip = box.querySelector<HTMLElement>('.plot__tip')!;
    const { W, H, pad, d, r, c, lx, ly } = data;
    const showX = (x: number) => fmt(lx ? 10 ** x : x);
    const showY = (y: number) => fmt(ly ? 10 ** y : y);
    const sx = (x: number) => pad.l + ((x - d[0]) / (d[1] - d[0])) * (W - pad.l - pad.r);
    const sy = (y: number) => H - pad.b - ((y - r[0]) / (r[1] - r[0])) * (H - pad.t - pad.b);
    const at = (pts: [number, number | null][], x: number) => {
      let lo = 0;
      let hi = pts.length - 1;
      if (x < pts[0][0] || x > pts[hi][0]) return null;
      while (hi - lo > 1) {
        const mid = (lo + hi) >> 1;
        if (pts[mid][0] <= x) lo = mid;
        else hi = mid;
      }
      const [x0, y0] = pts[lo];
      const [x1, y1] = pts[hi];
      if (y0 === null || y1 === null) return null;
      return x1 === x0 ? y0 : y0 + ((y1 - y0) * (x - x0)) / (x1 - x0);
    };
    const move = (e: PointerEvent) => {
      const m = svg.getScreenCTM();
      if (!m) return;
      const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
      if (p.x < pad.l || p.x > W - pad.r || p.y < pad.t - 8 || p.y > H - pad.b + 8) return leave();
      const x = d[0] + ((p.x - pad.l) / (W - pad.l - pad.r)) * (d[1] - d[0]);
      cross.setAttribute('x1', String(p.x));
      cross.setAttribute('x2', String(p.x));
      const rows: string[] = [`<b>x = ${showX(x)}</b>`];
      c.forEach(([label, pts]: [string, [number, number | null][]], i: number) => {
        const y = at(pts, x);
        const ok = y !== null && y >= r[0] && y <= r[1];
        dots[i].style.display = ok ? '' : 'none';
        if (ok) {
          dots[i].setAttribute('cx', String(p.x));
          dots[i].setAttribute('cy', String(sy(y!)));
        }
        if (y !== null) rows.push(`<i style="background:${colors[i]}"></i>${label} ${showY(y)}`);
      });
      tip.innerHTML = rows.join('<br>');
      box.classList.add('is-reading');
      const rect = box.getBoundingClientRect();
      const left = e.clientX - rect.left;
      const flip = left > rect.width * 0.6;
      tip.style.transform = `translate(${flip ? left - tip.offsetWidth - 14 : left + 14}px, 8px)`;
    };
    const leave = () => box.classList.remove('is-reading');
    svg.addEventListener('pointermove', move);
    svg.addEventListener('pointerleave', leave);
  });
</script>

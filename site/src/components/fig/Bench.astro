---
/**
 * Timing comparison: one row per operation, a bar per contender, scaled to
 * the slowest in that row. Times are in seconds.
 *
 *   rows    [{ label, times: [t0, t1, ...] }]
 *   series  names of the contenders, in the order of `times` (default:
 *           numpy, stardust 1 thread, stardust 10 threads)
 *   base    index of the contender speed-ups are measured against (default 0)
 */
interface Row {
  label: string;
  times: number[];
}
interface Props {
  rows: Row[];
  series?: string[];
  base?: number;
  caption?: string;
}
const { rows, series = ['numpy', 'stardust 1 thread', 'stardust 10 threads'], base = 0, caption } = Astro.props;

const fmt = (t: number) =>
  t < 1e-6 ? `${(t * 1e9).toFixed(0)} ns` : t < 1e-3 ? `${(t * 1e6).toFixed(t < 1e-5 ? 1 : 0)} µs` : `${(t * 1e3).toFixed(2)} ms`;
const speed = (b: number, t: number) => {
  const r = b / t;
  return r >= 10 ? `${r.toFixed(0)}×` : `${r.toFixed(r >= 1.995 ? 1 : 2)}×`;
};
---

<figure class="bench">
  <ul class="bench__legend">
    {
      series.map((s, i) => (
        <li>
          <span class:list={['bench__swatch', `bench__swatch--${i}`]} />
          {s}
        </li>
      ))
    }
  </ul>
  <div class="bench__rows">
    {
      rows.map((r) => {
        const max = Math.max(...r.times);
        return (
          <div class="bench__row">
            <span class="bench__label">{r.label}</span>
            <div class="bench__bars">
              {r.times.map((t, i) => (
                <div class="bench__line">
                  <span class:list={['bench__bar', `bench__bar--${i}`]} style={`width:${Math.max((t / max) * 100, 0.6)}%`} />
                  <span class="bench__value">
                    {fmt(t)}
                    {i !== base && <em class:list={[r.times[base] / t >= 1 ? 'is-faster' : 'is-slower']}>{speed(r.times[base], t)}</em>}
                  </span>
                </div>
              ))}
            </div>
          </div>
        );
      })
    }
  </div>
  {caption && <figcaption class="bench__caption">{caption}</figcaption>}
</figure>

<style>
  .bench {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-subtle);
    overflow: hidden;
  }
  .bench__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: var(--space-4) var(--space-5) 0;
    list-style: none;
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }
  .bench__legend li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }
  .bench__swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }
  .bench__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
  }
  .bench__row {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
  }
  .bench__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.4;
    color: var(--fg);
  }
  .bench__bars {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .bench__line {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }
  .bench__bar {
    flex: none;
    max-width: calc(100% - 92px);
    height: 10px;
    border-radius: 2px;
  }
  .bench__swatch--0,
  .bench__bar--0 {
    background: var(--slate-300);
  }
  .bench__swatch--1,
  .bench__bar--1 {
    background: var(--blue-300);
  }
  .bench__swatch--2,
  .bench__bar--2 {
    background: var(--blue-600);
  }
  .bench__swatch--3,
  .bench__bar--3 {
    background: var(--blue-900);
  }
  .bench__value {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .bench__value em {
    margin-left: var(--space-1);
    font-style: normal;
    font-weight: 600;
  }
  .bench__value em.is-faster {
    color: var(--blue-700);
  }
  .bench__value em.is-slower {
    color: var(--warn);
  }
  .bench__caption {
    padding: var(--space-3) var(--space-5);
    border-top: 1px solid var(--line);
    background: var(--bg);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-muted);
    text-align: center;
  }
  @media (max-width: 640px) {
    .bench__row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>

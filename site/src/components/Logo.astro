<a class="logo" href="/" aria-label="stardust 홈">
  <svg class="logo__mark" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
    <g fill="currentColor">
      <circle cx="4" cy="4" r="1" opacity=".55"></circle>
      <circle cx="10" cy="4" r="1.5" opacity=".8"></circle>
      <circle cx="16" cy="4" r=".85" opacity=".45"></circle>
      <circle cx="4" cy="10" r="1.5" opacity=".8"></circle>
      <circle cx="10" cy="10" r="2.5"></circle>
      <circle cx="16" cy="10" r="1.25" opacity=".7"></circle>
      <circle cx="4" cy="16" r=".85" opacity=".45"></circle>
      <circle cx="10" cy="16" r="1.25" opacity=".7"></circle>
      <circle cx="16" cy="16" r="1.7" opacity=".85"></circle>
    </g>
  </svg>
  <span class="logo__word">stardust</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--fg);
  }
  .logo__mark {
    color: var(--accent);
  }
  .logo__word {
    font-size: var(--text-lg);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1;
  }
</style>

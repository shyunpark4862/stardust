---
import Logo from './Logo.astro';
import Search from './Search.astro';
import { currentTop, topNav } from '../data/nav';
import { unbase, url } from '../lib/url';

interface Props {
  /** The page opens on a dark hero: start transparent with light text. */
  overDark?: boolean;
}
const { overDark = false } = Astro.props;
const current = currentTop(unbase(Astro.url.pathname));
---

<header class="header" data-surface={overDark ? 'dark' : undefined} data-over-dark={overDark ? '' : undefined}>
  <div class="container header__inner">
    <Logo />
    <nav class="header__nav" aria-label="Main">
      <Search />
      {
        topNav.map((item) =>
          item.external ? (
            <a class="header__link header__link--ext" href={item.href} rel="noopener">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
              </svg>
              <span class="header__ext-label">{item.label}</span>
            </a>
          ) : (
            <a class="header__link" href={url(item.href)} aria-current={current === item.href ? 'page' : undefined}>
              {item.short ? (
                <>
                  <span class="header__long">{item.label}</span>
                  <span class="header__short">{item.short}</span>
                </>
              ) : (
                item.label
              )}
            </a>
          ),
        )
      }
    </nav>
  </div>
</header>

<script>
  // On pages that open with a dark hero the header starts transparent and
  // switches to the light surface once the hero has scrolled out from under it.
  const header = document.querySelector<HTMLElement>('.header[data-over-dark]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (header && hero) {
    const update = () => {
      const past = hero.getBoundingClientRect().bottom <= header.offsetHeight;
      if (past) header.removeAttribute('data-surface');
      else header.setAttribute('data-surface', 'dark');
      header.classList.toggle('is-scrolled', !past && scrollY > 8);
    };
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid var(--line);
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .header[data-over-dark] {
    position: fixed;
    inset: 0 0 auto;
  }
  .header[data-surface='dark'] {
    border-bottom-color: transparent;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  /* Over the hero, once content starts to pass underneath. */
  .header[data-surface='dark'].is-scrolled {
    border-bottom-color: var(--line);
    background: rgb(4 8 22 / 0.72);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .header__link {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding-inline: var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--fg-muted);
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .header__link--ext {
    gap: var(--space-2);
  }
  .header__link {
    white-space: nowrap;
  }
  .header__short {
    display: none;
  }
  @media (max-width: 640px) {
    .header__long {
      display: none;
    }
    .header__short {
      display: inline;
    }
    .header__ext-label {
      display: none;
    }
    .header__link {
      padding-inline: var(--space-2);
    }
  }
  .header__link:hover {
    color: var(--fg);
    background: var(--bg-muted);
  }
  @media (max-width: 800px) {
    .header__link {
      height: 44px;
    }
  }
  .header__link[aria-current='page'] {
    position: relative;
    color: var(--fg);
    font-weight: 600;
  }
  .header__link[aria-current='page']::after {
    content: '';
    position: absolute;
    inset: auto var(--space-3) -14px;
    height: 2px;
    border-radius: 1px;
    background: var(--accent);
  }
  @media (max-width: 800px) {
    .header__link[aria-current='page']::after {
      bottom: -10px;
    }
  }
</style>

---
/**
 * Rows of the reference block: parameters, return values, errors or
 * attributes. A named row is name (with its tags and default) | type over
 * text; an unnamed one (an error, a single return value) is type | text;
 * a parameter with `choices` gets a value | meaning table under its text.
 */
import { inlineHtml } from '../../data/inline';
import { paramId } from '../../lib/signature';

interface Field {
  name?: string;
  kind?: string;
  default?: string;
  type: string;
  desc: string;
  choices?: [string, string][];
}
interface Props {
  items: Field[];
  /** Id prefix of named rows: "param" (signature links land here) or "attr". */
  ids?: 'param' | 'attr';
}
const { items, ids } = Astro.props;
const named = items.some((f) => f.name);
const rowId = (f: Field) => {
  if (!f.name || !ids) return undefined;
  const first = f.name.split(',')[0].trim();
  return ids === 'param' ? paramId(first) : `attr-${first}`;
};
---

<dl class:list={['fields', named && 'fields--named']}>
  {
    items.map((f) => (
      <div class="fields__row" id={rowId(f)}>
        {named && (
          <dt class="fields__key">
            <code class="fields__name">{f.name}</code>
            {f.kind && <span class="fields__tag">{f.kind}</span>}
            {f.default !== undefined && (
              <span class="fields__default">
                default <code>{f.default}</code>
              </span>
            )}
          </dt>
        )}
        {named ? null : <dt class="fields__type">{f.type}</dt>}
        <dd class="fields__text">
          {named && <span class="fields__type fields__type--line">{f.type}</span>}
          <span set:html={inlineHtml(f.desc)} />
          {f.choices && f.choices.length > 0 && (
            <table class="fields__choices">
              <thead>
                <tr>
                  <th scope="col">Value</th>
                  <th scope="col">Meaning</th>
                </tr>
              </thead>
              <tbody>
                {f.choices.map(([value, meaning]) => (
                  <tr>
                    <td>
                      <code>{value}</code>
                      {f.default !== undefined && f.default === value && <span class="fields__is-default">default</span>}
                    </td>
                    <td set:html={inlineHtml(meaning)} />
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .fields {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  /* Named and unnamed rows share the first column's width, so the text of
     Parameters, Returns and Raises starts on one edge. */
  .fields__row {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    scroll-margin-top: calc(var(--header-h) + var(--space-6));
  }
  .fields__row:last-child {
    border-bottom: 0;
  }
  /* A row the signature linked to: a brief tint shows where the jump landed. */
  .fields__row:target {
    background: var(--accent-soft);
    box-shadow:
      -12px 0 0 var(--accent-soft),
      12px 0 0 var(--accent-soft);
  }
  .fields__key {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    min-width: 0;
  }
  .fields__name {
    padding: 0;
    background: none;
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .fields__tag {
    padding: 1px 6px;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--fg-subtle);
  }
  .fields__default {
    font-size: var(--text-xs);
    color: var(--fg-subtle);
  }
  .fields__default code {
    padding: 0;
    background: none;
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }
  .fields__type--line {
    display: block;
    margin-bottom: var(--space-1);
  }
  .fields__type {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--blue-700);
    overflow-wrap: anywhere;
  }
  .fields__text {
    margin: 0;
    min-width: 0;
    line-height: var(--leading-normal);
    color: var(--slate-700);
  }
  .fields__choices {
    display: table;
    width: auto;
    margin: var(--space-3) 0 0;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .fields__choices th,
  .fields__choices td {
    padding: var(--space-1) var(--space-3) var(--space-1) 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .fields__choices th {
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--fg-subtle);
  }
  .fields__choices tr:last-child td {
    border-bottom: 0;
  }
  .fields__is-default {
    margin-left: var(--space-2);
    font-size: var(--text-xs);
    color: var(--fg-subtle);
  }
  @media (max-width: 720px) {
    .fields__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
  }
</style>

---
/**
 * <FunctionTables /> on an area overview: every group of the overview's
 * frontmatter, in that order, as a heading, its one-sentence description and
 * a table of its pages (name | summary).
 */
import { groupId, groupsOf, hrefOf, isCodeTitle, namesUnder } from '../../data/api';
import ApiTitle from '../docs/ApiTitle.astro';
import { inlineHtml } from '../../data/inline';
import { url } from '../../lib/url';

const area = Astro.locals.apiArea;
if (!area) throw new Error('<FunctionTables /> is only for area overviews (src/content/areas/)');
const groups = await groupsOf(area);
---

{
  groups.map((g) => (
    <section class="ftable">
      <h2 id={groupId(g.title)}>{g.title}</h2>
      <p class="ftable__desc" set:html={inlineHtml(g.desc)} />
      {g.entries.length > 0 ? (
        <table class="ftable__table">
          <tbody>
            {g.entries.map((e) => (
              <tr>
                <th scope="row">
                  <a href={url(hrefOf(e))} class:list={[isCodeTitle(e) && 'ftable__mono']}>
                    <ApiTitle text={e.data.title} code={isCodeTitle(e)} />
                  </a>
                  {namesUnder(e) && <span class="ftable__names">{namesUnder(e)!.join(' ')}</span>}
                </th>
                <td set:html={inlineHtml(e.data.summary)} />
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="ftable__empty">No pages in this group yet.</p>
      )}
    </section>
  ))
}

<style>
  /* The groups follow each other as one listing: after the first, a group
     heading is set apart by space, not by the rule of a new section. */
  .ftable + .ftable h2 {
    margin-top: var(--space-10);
    padding-top: 0;
    border-top: 0;
  }
  .ftable h2 + .ftable__desc {
    margin-top: var(--space-2);
  }
  .ftable__desc {
    color: var(--fg-muted);
  }
  .ftable__table {
    display: table;
    width: 100%;
    table-layout: fixed;
  }
  .ftable__table th {
    width: 34%;
    /* A family page's list of names wraps between names (and inside a long
       name when the column is narrow). */
    white-space: normal;
    overflow-wrap: break-word;
    font-weight: 400;
    text-align: left;
    vertical-align: top;
  }
  .ftable__table th a {
    font-weight: 600;
    color: var(--area, var(--accent));
    text-decoration: none;
  }
  .ftable__table th a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ftable__mono {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .ftable__names {
    display: block;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--fg-subtle);
  }
  .ftable__empty {
    font-size: var(--text-sm);
    color: var(--fg-subtle);
  }
  @media (max-width: 640px) {
    .ftable__table th {
      width: 42%;
    }
  }
</style>

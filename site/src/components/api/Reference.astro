---
/**
 * The reference block of an API page, placed in the body as <Reference />:
 * Parameters, Returns, Raises and, for classes, Attributes and Methods. The
 * page route puts the entry's frontmatter (and the links of methods that
 * have their own page) in Astro.locals.apiPage.
 */
import ApiFields from './ApiFields.astro';
import { inlineHtml } from '../../data/inline';
import { url } from '../../lib/url';
import { referenceSections } from '../../lib/reference';

const page = Astro.locals.apiPage;
if (!page) throw new Error('<Reference /> is only for pages under src/content/api/');
const { data, methodHref } = page;
const sections = referenceSections(data);
const has = (slug: string) => sections.some((s) => s.slug === slug);
---

{
  sections.length > 0 && (
    <>
      <h2 id="reference">Reference</h2>
      <section class="ref" aria-labelledby="reference">
        {has('parameters') && (
          <>
            <h3 class="ref__h" id="parameters">Parameters</h3>
            <ApiFields items={data.params} ids="param" />
          </>
        )}
        {has('returns') && (
          <>
            <h3 class="ref__h" id="returns">Returns</h3>
            <ApiFields items={data.returns} />
          </>
        )}
        {has('raises') && (
          <>
            <h3 class="ref__h" id="raises">Raises</h3>
            <ApiFields items={data.raises} />
          </>
        )}
        {has('attributes') && (
          <>
            <h3 class="ref__h" id="attributes">Attributes</h3>
            <ApiFields items={data.attributes} ids="attr" />
          </>
        )}
        {has('method-list') && (
          <>
            <h3 class="ref__h" id="method-list">Methods</h3>
            <dl class="methods">
              {data.methods.map((m) => (
                <div class="methods__row">
                  <dt>
                    {methodHref[m.name] === null ? (
                      <span class="methods__sig">
                        <code>{m.signature}</code>
                      </span>
                    ) : (
                      <a class="methods__sig" href={url(methodHref[m.name] ?? `#${m.name}`)}>
                        <code>{m.signature}</code>
                      </a>
                    )}
                  </dt>
                  <dd set:html={inlineHtml(m.summary)} />
                </div>
              ))}
            </dl>
          </>
        )}
      </section>
    </>
  )
}

<style>
  /* A framed block, not more sections: small labels, and the frame sets the
     block apart from the running text. */
  .ref {
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-6) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }
  .ref :global(.ref__h) {
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    scroll-margin-top: calc(var(--header-h) + var(--space-6));
  }
  .ref :global(.ref__h + *) {
    margin-top: var(--space-2);
  }
  .methods {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .methods__row {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    line-height: var(--leading-snug);
  }
  .methods__row:last-child {
    border-bottom: 0;
  }
  .methods dd {
    margin: 0;
    line-height: var(--leading-normal);
    color: var(--slate-700);
  }
  .methods__sig {
    text-decoration: none;
  }
  .methods__sig code {
    padding: 0;
    background: none;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--area, var(--blue-700));
    overflow-wrap: anywhere;
  }
  a.methods__sig:hover code {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 720px) {
    .ref {
      padding-inline: var(--space-4);
    }
    .methods__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
  }
</style>

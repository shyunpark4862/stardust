---
import Button from './Button.astro';
---

<section class="hero" data-surface="dark" data-hero>
  <div class="hero__sky" aria-hidden="true">
    <div class="hero__glow"></div>
    <div class="hero__core"></div>
    <canvas class="hero__canvas"></canvas>
    <div class="hero__veil"></div>
  </div>

  <div class="container hero__inner">
    <p class="eyebrow hero__eyebrow">Array · Linear algebra · Sparse · DataFrame · Special · Stats · Tests · Regression · Optimize · Calculus · Random · Spatial · FFT · Interpolate · Graph · Smooth · Plot</p>
    <h1 class="hero__title">
      <span class="hero__line">Numerics, rebuilt</span>
      <span class="hero__line hero__line--accent">down to the last bit.</span>
    </h1>
    <p class="hero__lead">
      stardust is a Python library for numerical computing, from arrays and linear algebra to statistics, optimization
      and plotting, with a core rebuilt from scratch in C++20. Every area follows the same rules, and the same input on
      the same machine gives the same result down to the last bit.
    </p>
    <div class="hero__actions">
      <Button href="/api/" size="lg" arrow>Browse the API</Button>
      <Button href="https://github.com/shyunpark4862/stardust" size="lg" variant="secondary">GitHub</Button>
    </div>
  </div>
</section>

<script>
  // The backdrop: the finished galaxy, turning slowly.
  const host = document.querySelector<HTMLElement>('.hero');
  const canvas = document.querySelector<HTMLCanvasElement>('.hero__canvas');
  if (host && canvas) {
    import('../scripts/stardust').then((m) => m.mountStardust(canvas, host));
  }
</script>

<style>
  .hero {
    --core-x: 70%;
    --core-y: 53%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: max(100svh, 680px);
    padding-top: var(--header-h);
    background: var(--night-950);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---- Backdrop ---- */
  .hero__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(90rem 50rem at 80% 110%, rgb(28 68 184 / 0.28), transparent 70%),
      linear-gradient(180deg, var(--night-950), var(--night-900) 60%, #07102a);
  }
  /* The light around the core of the galaxy. */
  .hero__core {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(38rem 24rem at var(--core-x) var(--core-y), rgb(72 118 255 / 0.18), transparent 70%),
      radial-gradient(12rem 8rem at var(--core-x) var(--core-y), rgb(255 228 196 / 0.14), transparent 70%);
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1200ms var(--ease);
  }
  .hero__canvas:global(.is-ready) {
    opacity: 1;
  }
  /* Keeps the copy legible where the disc passes behind it. */
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(4 8 22 / 0.72), rgb(4 8 22 / 0.3) 42%, transparent 62%),
      linear-gradient(0deg, var(--night-950), rgb(4 8 22 / 0.6) 10%, transparent 30%);
  }

  /* ---- Copy ---- */
  .hero__inner {
    padding-block: var(--space-20) var(--space-24);
  }
  .hero__title {
    margin-top: var(--space-6);
    font-size: clamp(2.5rem, 6.4vw, 5.25rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.045em;
    text-wrap: nowrap;
  }
  .hero__line {
    display: block;
  }
  .hero__line--accent {
    padding-bottom: 0.1em; /* room for descenders under background-clip */
    background: linear-gradient(92deg, #ffffff 0%, var(--blue-200) 38%, var(--blue-400) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lead {
    max-width: 34rem;
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--fg-muted);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-10);
  }

  /* ---- Entrance ---- */
  .hero__eyebrow,
  .hero__line,
  .hero__lead,
  .hero__actions {
    animation: rise 1100ms var(--ease) backwards;
  }
  .hero__eyebrow {
    animation-delay: 150ms;
  }
  .hero__line:nth-child(1) {
    animation-delay: 250ms;
  }
  .hero__line:nth-child(2) {
    animation-delay: 380ms;
  }
  .hero__lead {
    animation-delay: 560ms;
  }
  .hero__actions {
    animation-delay: 680ms;
  }
  /* The entrance starts from a faint, not an invisible, state: where
     animations never run (a background tab, print, some readers) the text
     is still there to read. */
  @keyframes rise {
    from {
      opacity: 0.25;
      transform: translateY(18px);
    }
  }

  @media (max-width: 800px) {
    .hero {
      justify-content: flex-start;
    }
    .hero__inner {
      padding-block: var(--space-16) var(--space-32);
    }
    .hero__title {
      text-wrap: balance;
    }
    .hero__veil {
      background: linear-gradient(180deg, rgb(4 8 22 / 0.7), rgb(4 8 22 / 0.2) 55%, rgb(4 8 22 / 0.5));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow,
    .hero__line,
    .hero__lead,
    .hero__actions {
      animation: none;
    }
  }
</style>

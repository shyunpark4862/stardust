---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  overDark?: boolean;
}
const {
  title,
  description = 'A Python library for numerical computing, from arrays and linear algebra to statistics and plotting, with a core written from scratch in C++20.',
  overDark = false,
} = Astro.props;
const fullTitle = title ? `${title} · stardust` : 'stardust';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={overDark ? '#060b1c' : '#ffffff'} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <title>{fullTitle}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header overDark={overDark} />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      // Hide only what starts below the fold, and only in a visible tab with
      // motion allowed; IntersectionObserver brings each one back.
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!calm && !document.hidden && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.remove('reveal-wait');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
          if (el.getBoundingClientRect().top < innerHeight * 0.9) return;
          el.classList.add('reveal-wait');
          io.observe(el);
        });
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--blue-600);
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
    transform: translateY(-200%);
  }
  .skip:focus {
    transform: none;
  }
</style>

---
/**
 * An area overview: src/content/areas/<area>.mdx. Lead and "At a glance"
 * cards come from the frontmatter; the body places <FunctionTables /> (the
 * groups, in frontmatter order) and <ResultTable /> where the author wants.
 */
import { getCollection, render } from 'astro:content';
import Docs from '../../../layouts/Docs.astro';
import FunctionTables from '../../../components/api/FunctionTables.astro';
import ResultTable from '../../../components/api/ResultTable.astro';
import { inlineHtml } from '../../../data/inline';
import { url } from '../../../lib/url';
import {
  areaCrumbs,
  areaNav,
  areaOf,
  areaSidebar,
  groupId,
  groupsOf,
  headingsBefore,
  hrefOf,
  isSingle,
  resolveRef,
} from '../../../data/api';

export async function getStaticPaths() {
  return (await getCollection('areas')).map((entry) => {
    areaOf(entry.id);
    return { params: { area: entry.id }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { area } = Astro.params;
const { data } = entry;
Astro.locals.apiArea = area;
const { Content, headings: raw } = await render(entry);
const groups = await groupsOf(area);
const pages = groups.reduce((n, g) => n + g.entries.length, 0);
const glance = await Promise.all(data.glance.map(async (slug) => ({ slug, entry: await resolveRef(area, slug) })));

// Table of contents: At a glance, then the body's headings with the group
// headings of <FunctionTables /> at the place the component sits.
const body = raw.filter((h) => h.depth <= 3);
const groupHeads = groups.map((g) => ({ depth: 2, slug: groupId(g.title), text: g.title }));
const at = headingsBefore(entry.body, 'FunctionTables');
const headings = [
  ...(glance.length > 0 ? [{ depth: 2, slug: 'at-a-glance', text: 'At a glance' }] : []),
  ...(at === undefined ? body : [...body.slice(0, at), ...groupHeads, ...body.slice(at)]),
];
---

<Docs
  title={data.title}
  description={data.lead}
  section="api"
  crumbs={areaCrumbs(area).slice(0, 1)}
  groups={await areaSidebar(area)}
  area={await areaNav(area)}
  headings={headings}
  meta={[`${pages} ${pages === 1 ? 'page' : 'pages'}`]}
>
  {
    glance.length > 0 && (
      <>
        <h2 id="at-a-glance">At a glance</h2>
        <ul class="glance">
          {glance.map(({ slug, entry: e }) => (
            <li>
              {e ? (
                <a class="glance__card" href={url(hrefOf(e))}>
                  <span class:list={['glance__title', isSingle(e) && 'glance__title--mono']}>{e.data.title}</span>
                  <span class="glance__summary" set:html={inlineHtml(e.data.summary)} />
                </a>
              ) : (
                <span class="glance__card glance__card--off">
                  <span class="glance__title glance__title--mono">{slug.split('/').pop()}</span>
                  <span class="glance__summary">No page yet.</span>
                </span>
              )}
            </li>
          ))}
        </ul>
      </>
    )
  }
  <Content components={{ FunctionTables, ResultTable }} />
</Docs>

<style>
  .glance {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }
  .glance li {
    display: grid;
    margin: 0;
  }
  .glance__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg);
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  a.glance__card:hover {
    border-color: var(--area-line);
    background: var(--area-soft);
  }
  .glance__card--off {
    border-style: dashed;
  }
  .glance__title {
    font-size: var(--text-md);
    font-weight: 650;
    line-height: var(--leading-snug);
    color: var(--fg);
  }
  .glance__title--mono {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--area);
  }
  .glance__card--off .glance__title {
    color: var(--fg-subtle);
  }
  .glance__summary {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--fg-muted);
  }
  @media (max-width: 640px) {
    .glance {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

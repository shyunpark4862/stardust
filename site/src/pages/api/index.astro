---
import { getCollection } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import LinkCard from '../../components/LinkCard.astro';
import { areas, type NavGroup } from '../../data/nav';
import { documentedAreas } from '../../data/api';

const documented = await documentedAreas();
const pages = await getCollection('api');
const count = (key: string) => pages.filter((p) => p.id.startsWith(`${key}/`)).length;
const sample = (key: string) => pages.filter((p) => p.id.startsWith(`${key}/`)).every((p) => p.data.sample);

const groups: NavGroup[] = [
  { title: 'API', items: [{ label: 'All areas', href: '/api/' }] },
  {
    title: 'Areas',
    items: areas
      .filter((a) => documented.includes(a.key))
      .map((a) => ({ label: a.name, href: `/api/${a.key}/`, badge: sample(a.key) ? 'Sample' : undefined })),
  },
];
---

<Docs
  title="API"
  description="The API reference, by area. Pick an area to see its concepts and functions."
  section="api"
  crumbs={[]}
  groups={groups}
>
  <div class="grid">
    {
      areas.map((a) => {
        const has = documented.includes(a.key);
        return (
          <LinkCard
            href={has ? `/api/${a.key}/` : undefined}
            title={a.name}
            meta={a.ns}
            area={a.key}
            badge={!has ? 'Soon' : sample(a.key) ? 'Sample' : `${count(a.key)} pages`}
            badgeTone={has && !sample(a.key) ? 'accent' : 'neutral'}
          >
            {a.desc}
          </LinkCard>
        );
      })
    }
  </div>
</Docs>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

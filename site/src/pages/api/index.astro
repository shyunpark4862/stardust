---
/**
 * /api/: every area as a card. An area with an overview page links to it;
 * the others show "Soon" and are not links.
 */
import { getCollection } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import LinkCard from '../../components/LinkCard.astro';
import { areas, type NavGroup } from '../../data/nav';
import { documentedAreas, overviewOf } from '../../data/api';

const documented = await documentedAreas();
const pages = await getCollection('api');
const count = (key: string) => pages.filter((p) => p.id.startsWith(`${key}/`)).length;
const titles = Object.fromEntries(
  await Promise.all(documented.map(async (k) => [k, (await overviewOf(k))!.data.title] as const)),
);

const groups: NavGroup[] = [
  { title: 'API', items: [{ label: 'All areas', href: '/api/' }, { label: 'Index of names', href: '/api/all/' }] },
  {
    title: 'Areas',
    items: areas.filter((a) => documented.includes(a.key)).map((a) => ({ label: titles[a.key], href: `/api/${a.key}/` })),
  },
];
---

<Docs
  title="API reference"
  description="The reference, by area. Each area page lists its functions and classes by topic."
  section="api"
  crumbs={[]}
  groups={groups}
>
  <div class="grid">
    {
      areas.map((a) => {
        const has = documented.includes(a.key);
        const n = count(a.key);
        return (
          <LinkCard
            href={has ? `/api/${a.key}/` : undefined}
            title={has ? titles[a.key] : a.name}
            meta={a.ns}
            area={a.key}
            badge={has ? `${n} ${n === 1 ? 'page' : 'pages'}` : 'Soon'}
            badgeTone={has ? 'accent' : 'neutral'}
          >
            {a.desc}
          </LinkCard>
        );
      })
    }
  </div>
</Docs>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
